<% content_for :title, t("business_cases.invitation.title") %>

<main id="main" class="mx-auto max-w-page px-4 pt-11 pb-20 sm:px-8">
  <div class="mx-auto max-w-2xl rounded-card border border-hairline bg-surface-1 p-6 sm:p-8">
    <p class="font-mono text-12 text-muted"><%= t("business_cases.invitation.eyebrow") %></p>
    <h1 class="mt-3 text-32 font-bold tracking-[-0.035em] text-ink"><%= t("business_cases.invitation.title") %></h1>
    <p class="mt-3 text-16 leading-relaxed text-muted">
      <%= t("business_cases.invitation.subtitle",
            business_case: @invitation.business_case.title,
            organization: @invitation.business_case.organization.name) %>
    </p>
    <p class="mt-4 text-13 text-muted">
      <%= t("business_cases.invitation.expires", date: l(@invitation.expires_at.to_date, format: :long)) %>
    </p>
    <div class="mt-6 rounded-card border border-hairline bg-surface-2 p-4 text-13 leading-[1.65] text-muted">
      <%= t("business_cases.policy_notice") %>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <%= button_to t("business_cases.invitation.accept"),
            accept_business_case_invitation_path(@token),
            method: :post,
            class: "rounded-full bg-brand px-5 py-3 text-13 font-semibold text-white transition hover:bg-brand-dark" %>
      <%= button_to t("business_cases.invitation.decline"),
            decline_business_case_invitation_path(@token),
            method: :post,
            class: "rounded-full border border-hairline px-5 py-3 text-13 font-semibold text-muted transition hover:border-brand-ink hover:text-brand-ink" %>
    </div>
  </div>
</main>
