<%# The sign-up panel — see sessions/_form for why `autofocus` is a local.
    `@user` carries the validation errors when RegistrationsController#create
    re-renders; SessionsController#new builds an empty one for this panel. %>
<h1 class="mb-2 text-28 leading-[1.2] font-bold tracking-[-0.025em]"><%= t("auth.register.title") %></h1>
<p class="mb-7 text-15 leading-[1.6] text-balance text-muted"><%= t("auth.register.subtitle") %></p>

<%= form_with model: @user, url: register_path do |form| %>
  <%= render "shared/form_errors", record: @user %>

  <div class="mb-5.5 flex flex-col gap-4">
    <label class="flex flex-col gap-1.75">
      <span class="text-13-5 font-medium text-ink-4"><%= t("auth.fields.name") %></span>
      <%= form.text_field :name, required: true, autofocus: autofocus, autocomplete: "name",
            placeholder: t("auth.fields.name_placeholder"),
            "aria-invalid": @user.errors[:name].any?.to_s,
            class: "rounded-field border-[1.5px] bg-surface px-3.75 py-3.25 text-15 text-ink transition-colors
                    outline-none placeholder:text-muted-3 focus:border-brand-ink
                    aria-[invalid=true]:border-brand-alert border-hairline-2" %>
    </label>

    <label class="flex flex-col gap-1.75">
      <span class="text-13-5 font-medium text-ink-4"><%= t("auth.fields.student_id") %></span>
      <%# 13 digits, matching User::STUDENT_ID_FORMAT. %>
      <%= form.text_field :student_id, required: true, autocomplete: "username",
            placeholder: "2X1071730XXXX",
            inputmode: "numeric", pattern: "[0-9]{13}", maxlength: 13,
            spellcheck: false, autocapitalize: "off",
            title: t("auth.fields.student_id_hint"),
            "aria-invalid": @user.errors[:student_id].any?.to_s,
            class: "rounded-field border-[1.5px] bg-surface px-3.75 py-3.25 text-15 text-ink transition-colors
                    outline-none placeholder:text-muted-3 focus:border-brand-ink
                    aria-[invalid=true]:border-brand-alert border-hairline-2" %>
      <span class="text-12-5 text-muted-2"><%= t("auth.fields.student_id_hint") %></span>
    </label>

    <label class="flex flex-col gap-1.75">
      <span class="text-13-5 font-medium text-ink-4"><%= t("auth.fields.password") %></span>
      <%= form.password_field :password, required: true, minlength: 8, maxlength: 72,
            autocomplete: "new-password", placeholder: "••••••••",
            "aria-invalid": @user.errors[:password].any?.to_s,
            class: "rounded-field border-[1.5px] bg-surface px-3.75 py-3.25 text-15 text-ink transition-colors
                    outline-none placeholder:text-muted-3 focus:border-brand-ink
                    aria-[invalid=true]:border-brand-alert border-hairline-2" %>
      <span class="text-12-5 text-muted-2"><%= t("auth.fields.password_hint") %></span>
    </label>

    <label class="flex flex-col gap-1.75">
      <span class="text-13-5 font-medium text-ink-4"><%= t("auth.fields.password_confirmation") %></span>
      <%= form.password_field :password_confirmation, required: true, minlength: 8, maxlength: 72,
            autocomplete: "new-password", placeholder: "••••••••",
            "aria-invalid": @user.errors[:password_confirmation].any?.to_s,
            class: "rounded-field border-[1.5px] bg-surface px-3.75 py-3.25 text-15 text-ink transition-colors
                    outline-none placeholder:text-muted-3 focus:border-brand-ink
                    aria-[invalid=true]:border-brand-alert border-hairline-2" %>
    </label>
  </div>

  <%# Required in the markup and re-checked in the controller. %>
  <label class="mb-6 flex items-start gap-2.5 text-14 leading-[1.55] text-ink-4">
    <%= check_box_tag :terms, "1", @accepted_terms, required: true,
          class: "mt-0.5 size-4.5 flex-none rounded-[5px] border-[1.5px] border-hairline-3 accent-brand" %>
    <span><%= t("auth.terms") %></span>
  </label>

  <%= form.submit t("auth.register.submit"),
        class: "mb-4 w-full cursor-pointer rounded-[12px] bg-brand py-3.5 text-15-5 font-semibold text-white
                transition-colors hover:bg-brand-deep" %>
<% end %>

<%= render "shared/auth_sso" %>

<p class="mt-6.5 text-13-5 leading-[1.6] text-balance text-muted-2"><%= t("auth.register.help") %></p>
