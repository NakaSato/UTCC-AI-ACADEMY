<% content_for :title, "สมัครสมาชิก — UTCC AI Fundamental" %>

<div class="brand-field grid min-h-[calc(100vh_-_var(--spacing-header))] place-items-center px-4 py-8">
  <div class="w-full max-w-lg rounded-box bg-surface p-8 shadow-2xl">
    <div class="mb-8 text-center">
      <h1 class="text-36 leading-tight font-bold text-balance text-brand-deep">สมัครสมาชิก</h1>
      <p class="mt-2 text-18 text-muted">เข้าร่วมชุมชนเรียนรู้ AI ของนักศึกษา UTCC</p>
    </div>

    <%= form_with model: @user, url: registration_path, class: "flex flex-col gap-4" do |form| %>
      <%= render "shared/form_errors", record: @user %>

      <div class="flex flex-col gap-1">
        <%= form.label :name, "ชื่อที่แสดง", class: "text-18 font-medium text-ink-2" %>
        <%= form.text_field :name, required: true, autofocus: true,
              autocomplete: "name", placeholder: "เช่น สมชาย ใจดี",
              "aria-invalid": @user.errors[:name].any?.to_s,
              class: "w-full rounded-md border border-hairline bg-surface px-3.5 py-2.5 text-18 transition duration-300
                      placeholder:text-muted-2 focus:border-brand focus:ring-3 focus:ring-brand/15 focus:outline-none
                      aria-[invalid=true]:border-brand-alert" %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :email_address, "อีเมล", class: "text-18 font-medium text-ink-2" %>
        <%= form.email_field :email_address, required: true,
              autocomplete: "username", placeholder: "you@utcc.ac.th",
              "aria-invalid": @user.errors[:email_address].any?.to_s,
              class: "w-full rounded-md border border-hairline bg-surface px-3.5 py-2.5 text-18 transition duration-300
                      placeholder:text-muted-2 focus:border-brand focus:ring-3 focus:ring-brand/15 focus:outline-none
                      aria-[invalid=true]:border-brand-alert" %>
      </div>

      <%# Upstream's non-standard 576px stop is the xs breakpoint — see the @theme block. %>
      <div class="grid grid-cols-1 gap-4 xs:grid-cols-2">
        <div class="flex flex-col gap-1">
          <%= form.label :password, "รหัสผ่าน", class: "text-18 font-medium text-ink-2" %>
          <%= form.password_field :password, required: true, maxlength: 72,
                autocomplete: "new-password",
                "aria-invalid": @user.errors[:password].any?.to_s,
                class: "w-full rounded-md border border-hairline bg-surface px-3.5 py-2.5 text-18 transition duration-300
                        placeholder:text-muted-2 focus:border-brand focus:ring-3 focus:ring-brand/15 focus:outline-none
                        aria-[invalid=true]:border-brand-alert" %>
          <span class="text-18 text-muted-2">อย่างน้อย 8 ตัวอักษร</span>
        </div>

        <div class="flex flex-col gap-1">
          <%= form.label :password_confirmation, "ยืนยันรหัสผ่าน", class: "text-18 font-medium text-ink-2" %>
          <%= form.password_field :password_confirmation, required: true, maxlength: 72,
                autocomplete: "new-password",
                "aria-invalid": @user.errors[:password_confirmation].any?.to_s,
                class: "w-full rounded-md border border-hairline bg-surface px-3.5 py-2.5 text-18 transition duration-300
                        placeholder:text-muted-2 focus:border-brand focus:ring-3 focus:ring-brand/15 focus:outline-none
                        aria-[invalid=true]:border-brand-alert" %>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 xs:grid-cols-2">
        <div class="flex flex-col gap-1">
          <%= form.label :faculty, "คณะ (ไม่บังคับ)", class: "text-18 font-medium text-ink-2" %>
          <%= form.text_field :faculty, placeholder: "เช่น วิศวกรรมศาสตร์",
                class: "w-full rounded-md border border-hairline bg-surface px-3.5 py-2.5 text-18 transition duration-300
                        placeholder:text-muted-2 focus:border-brand focus:ring-3 focus:ring-brand/15 focus:outline-none
                        aria-[invalid=true]:border-brand-alert" %>
        </div>

        <div class="flex flex-col gap-1">
          <%= form.label :study_year, "ชั้นปี (ไม่บังคับ)", class: "text-18 font-medium text-ink-2" %>
          <%= form.select :study_year, (1..8).map { |y| [ "ปีที่ #{y}", y ] },
                { include_blank: "—" },
                class: "w-full rounded-md border border-hairline bg-surface px-3.5 py-2.5 text-18 transition duration-300
                        focus:border-brand focus:ring-3 focus:ring-brand/15 focus:outline-none" %>
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <%= form.submit "สมัครสมาชิก",
              class: "inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand px-6 py-2.5 text-18
                      leading-tight font-normal whitespace-nowrap uppercase text-surface transition duration-300
                      hover:bg-brand-deep active:scale-97" %>
      </div>
    <% end %>

    <p class="mt-4 border-t border-hairline pt-4 text-center text-18 text-muted">
      มีบัญชีอยู่แล้ว?
      <%= link_to "เข้าสู่ระบบ", new_session_path, class: "font-medium text-brand hover:underline" %>
    </p>
  </div>
</div>
