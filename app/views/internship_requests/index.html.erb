<% content_for :title, "#{t("internship_requests.title")} — UTCC AI Academy" %>

<main id="main" class="mx-auto max-w-page px-4 pt-11 pb-20 sm:px-8">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="mb-2 text-11 font-semibold tracking-[0.14em] text-muted uppercase"><%= t("internship_requests.eyebrow") %></p>
      <h1 class="text-32 font-bold tracking-[-0.035em] text-ink"><%= t("internship_requests.title") %></h1>
      <p class="mt-2 max-w-[58ch] text-14 leading-[1.65] text-muted"><%= t("internship_requests.subtitle") %></p>
    </div>
    <% if @can_request %>
      <%= link_to t("internship_requests.new"), new_internship_request_path,
            class: "rounded-full bg-brand px-4 py-2.5 text-13 font-semibold text-white transition hover:bg-brand-dark" %>
    <% end %>
  </div>

  <%# An internship that is running comes first: the request that started it is
      history, and a missing weekly report is the only thing on this screen
      somebody else is waiting for. %>
  <% if @placements.any? %>
    <section class="mb-8">
      <h2 class="mb-4 text-18 font-semibold text-ink"><%= t("internship_placements.mine_heading") %></h2>
      <ul class="space-y-4">
        <% @placements.each do |placement| %>
          <li>
            <%= link_to internship_placement_path(placement),
                  class: "block rounded-card border border-hairline bg-surface-1 p-6 transition hover:border-brand-ink hover:shadow-sm" do %>
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <h3 class="text-18 font-semibold text-ink"><%= placement.organization.name %></h3>
                  <p class="mt-1 text-13 text-muted"><%= t("internship_placements.status.#{placement.status}") %></p>
                </div>
                <% if placement.missing_current_week_report? %>
                  <span class="rounded-full bg-surface-2 px-2.5 py-1 text-11 font-semibold text-brand-ink">
                    <%= t("internship_placements.week_missing") %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%= link_to t("internship_requests.all_internships"), internship_placements_path,
            class: "mt-4 inline-flex text-13 font-semibold text-brand-ink hover:underline" %>
    </section>
  <% end %>

  <section class="mb-8">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-20 font-semibold text-ink"><%= t("recruitment.internships.public_title") %></h2>
        <p class="mt-1 text-13 text-muted"><%= t("recruitment.internships.public_subtitle") %></p>
      </div>
      <%= link_to t("internship_requests.all_internships"), recruitment_internships_path,
            class: "text-13 font-semibold text-brand-ink hover:underline" %>
    </div>

    <% if @open_internships.empty? %>
      <div class="rounded-card border border-dashed border-hairline bg-surface-1 p-6 text-center text-14 text-muted">
        <%= t("recruitment.internships.empty_public") %>
      </div>
    <% else %>
      <div class="grid gap-4 md:grid-cols-2">
        <% @open_internships.each do |program| %>
          <article class="rounded-card border border-hairline bg-surface-1 p-6" data-program-id="<%= program.id %>">
            <p class="text-12 text-muted"><%= program.organization.name %></p>
            <h3 class="mt-1 text-18 font-semibold text-ink">
              <%= link_to program.name.presence || t("recruitment.internships.untitled"),
                    recruitment_internship_path(program), class: "hover:text-brand-ink" %>
            </h3>
            <p class="mt-3 line-clamp-2 text-13 leading-relaxed text-muted"><%= program.description %></p>
            <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-12 text-muted">
              <span><%= t("recruitment.internships.duration", count: program.duration_weeks) %></span>
              <span><%= t("recruitment.internships.remote_policies.#{program.remote_policy}") %></span>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  </section>

  <div class="mb-8 rounded-card border border-hairline bg-surface-2 p-4 text-13 leading-[1.65] text-muted">
    <%= t("internship_requests.positionless_notice") %>
  </div>

  <% if @requests.empty? %>
    <div class="rounded-card border border-dashed border-hairline bg-surface-1 p-8 text-center">
      <h2 class="text-18 font-semibold text-ink"><%= t("internship_requests.empty_title") %></h2>
      <p class="mt-2 text-14 text-muted">
        <%= @can_request ? t("internship_requests.empty_body") : t("internship_requests.none_accepting") %>
      </p>
    </div>
  <% else %>
    <ul class="space-y-4">
      <% @requests.each do |internship_request| %>
        <li>
          <%= link_to internship_request_path(internship_request),
                class: "block rounded-card border border-hairline bg-surface-1 p-6 transition hover:border-brand-ink hover:shadow-sm" do %>
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <h2 class="text-18 font-semibold text-ink"><%= internship_request.organization.name %></h2>
                <p class="mt-1 text-13 text-muted"><%= l(internship_request.created_at, format: :short) %></p>
              </div>
              <span class="rounded-full bg-surface-2 px-2.5 py-1 text-11 font-semibold text-muted"><%= t("internship_requests.status.#{internship_request.status}") %></span>
            </div>
            <p class="mt-4 line-clamp-2 text-13 text-muted"><%= internship_request.motivation %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</main>
