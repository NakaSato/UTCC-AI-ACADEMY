<% content_for :title, "#{@internship_request.organization.name} — #{t("internship_requests.title")}" %>

<main id="main" class="mx-auto max-w-page px-4 pt-11 pb-20 sm:px-8">
  <div class="mb-8">
    <%= link_to t("internship_requests.back"), internship_requests_path,
          class: "text-13 font-semibold text-brand-ink hover:underline" %>
    <div class="mt-5 flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="mb-2 text-11 font-semibold tracking-[0.14em] text-muted uppercase"><%= t("internship_requests.eyebrow") %></p>
        <h1 class="text-32 font-bold tracking-[-0.035em] text-ink"><%= @internship_request.organization.name %></h1>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-surface-2 px-3 py-1.5 text-12 font-semibold text-muted"><%= t("internship_requests.status.#{@internship_request.status}") %></span>
        <% if @internship_request.editable_by_student? %>
          <%= link_to t("internship_requests.edit"), edit_internship_request_path(@internship_request),
                class: "rounded-full border border-hairline px-4 py-2 text-13 font-semibold text-muted transition hover:border-brand-ink hover:text-brand-ink" %>
          <%= button_to t("internship_requests.submit_request"), submit_internship_request_path(@internship_request),
                class: "rounded-full bg-brand px-4 py-2 text-13 font-semibold text-white transition hover:bg-brand-dark" %>
        <% end %>
        <% if @internship_request.open? %>
          <%= button_to t("internship_requests.withdraw"), withdraw_internship_request_path(@internship_request),
                class: "rounded-full border border-red-200 px-4 py-2 text-13 font-semibold text-red-700 transition hover:bg-red-50" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mb-8 rounded-card border border-hairline bg-surface-2 p-4 text-13 leading-[1.65] text-muted">
    <%= t("internship_requests.positionless_notice") %>
  </div>

  <div class="grid gap-8 lg:grid-cols-[2fr_1fr]">
    <div class="space-y-8">
      <section class="rounded-card border border-hairline bg-surface-1 p-6">
        <h2 class="text-16 font-semibold text-ink"><%= t("internship_requests.fields.motivation") %></h2>
        <p class="mt-3 text-14 leading-[1.7] whitespace-pre-line text-muted"><%= @internship_request.motivation %></p>
      </section>

      <section class="rounded-card border border-hairline bg-surface-1 p-6">
        <h2 class="text-16 font-semibold text-ink"><%= t("internship_requests.fields.learning_goals") %></h2>
        <p class="mt-3 text-14 leading-[1.7] whitespace-pre-line text-muted"><%= @internship_request.learning_goals %></p>
      </section>

      <% if @internship_request.decided? %>
        <section class="rounded-card border border-hairline bg-surface-1 p-6">
          <h2 class="text-16 font-semibold text-ink"><%= t("internship_requests.decision_heading") %></h2>
          <p class="mt-3 text-14 text-muted">
            <%= t("internship_requests.decision_recorded",
                  outcome: t("internship_requests.status.#{@internship_request.status}"),
                  date: l(@internship_request.decided_at, format: :short)) %>
          </p>
          <% if @internship_request.decision_reason.present? %>
            <p class="mt-3 text-14 leading-[1.7] whitespace-pre-line text-muted"><%= @internship_request.decision_reason %></p>
          <% end %>
          <% if @internship_request.approved? %>
            <p class="mt-4 rounded-xl border border-hairline bg-surface-2 p-3 text-13 leading-[1.65] text-muted">
              <%= t("internship_requests.approved_next_steps") %>
            </p>
          <% end %>
        </section>
      <% end %>
    </div>

    <aside>
      <section class="rounded-card border border-hairline bg-surface-1 p-6">
        <h2 class="text-16 font-semibold text-ink"><%= t("internship_requests.timeline_heading") %></h2>
        <dl class="mt-4 space-y-3 text-13">
          <div>
            <dt class="font-semibold text-ink"><%= t("internship_requests.timeline.created") %></dt>
            <dd class="mt-0.5 text-muted"><%= l(@internship_request.created_at, format: :short) %></dd>
          </div>
          <% { submitted: @internship_request.submitted_at, reviewed: @internship_request.reviewed_at,
               decided: @internship_request.decided_at, withdrawn: @internship_request.withdrawn_at }.each do |key, at| %>
            <% next if at.blank? %>
            <div>
              <dt class="font-semibold text-ink"><%= t("internship_requests.timeline.#{key}") %></dt>
              <dd class="mt-0.5 text-muted"><%= l(at, format: :short) %></dd>
            </div>
          <% end %>
        </dl>
      </section>
    </aside>
  </div>
</main>
