<% content_for :title, "ตั้งรหัสผ่านใหม่ — UTCC AI Fundamental" %>

<div class="brand-field grid min-h-[calc(100vh_-_var(--spacing-header))] place-items-center px-4 py-8">
  <div class="w-full max-w-lg rounded-box bg-surface p-8 shadow-2xl">
    <div class="mb-8 text-center">
      <h1 class="text-36 leading-tight font-bold text-balance text-brand-deep">ตั้งรหัสผ่านใหม่</h1>
      <p class="mt-2 text-18 text-muted">กรอกรหัสผ่านใหม่ที่ต้องการใช้</p>
    </div>

    <%= form_with url: password_path(params[:token]), method: :put, class: "flex flex-col gap-4" do |form| %>
      <div class="flex flex-col gap-1">
        <%= form.label :password, "รหัสผ่านใหม่", class: "text-18 font-medium text-ink-2" %>
        <%= form.password_field :password, required: true, autofocus: true, maxlength: 72,
              autocomplete: "new-password",
              class: "w-full rounded-md border border-hairline bg-surface px-3.5 py-2.5 text-18 transition duration-300
                      placeholder:text-muted-2 focus:border-brand focus:ring-3 focus:ring-brand/15 focus:outline-none
                      aria-[invalid=true]:border-brand-alert" %>
        <span class="text-18 text-muted-2">อย่างน้อย 8 ตัวอักษร</span>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :password_confirmation, "ยืนยันรหัสผ่านใหม่", class: "text-18 font-medium text-ink-2" %>
        <%= form.password_field :password_confirmation, required: true, maxlength: 72,
              autocomplete: "new-password",
              class: "w-full rounded-md border border-hairline bg-surface px-3.5 py-2.5 text-18 transition duration-300
                      placeholder:text-muted-2 focus:border-brand focus:ring-3 focus:ring-brand/15 focus:outline-none
                      aria-[invalid=true]:border-brand-alert" %>
      </div>

      <div class="flex flex-col gap-2">
        <%= form.submit "บันทึกรหัสผ่าน",
              class: "inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand px-6 py-2.5 text-18
                      leading-tight font-normal whitespace-nowrap uppercase text-surface transition duration-300
                      hover:bg-brand-deep active:scale-97" %>
      </div>
    <% end %>
  </div>
</div>
