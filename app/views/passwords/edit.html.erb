<% content_for :title, "#{t("auth.reset.title")} — UTCC AI Academy" %>

<%= link_to t("auth.back"), login_path,
      class: "mb-5.5 inline-block text-13-5 text-muted hover:text-ink" %>

<h1 class="mb-2 text-28 leading-[1.2] font-bold tracking-[-0.025em]"><%= t("auth.reset.title") %></h1>
<p class="mb-7 text-15 leading-[1.6] text-balance text-muted"><%= t("auth.reset.subtitle") %></p>

<%= form_with url: reset_password_path(params[:token]), method: :put do |form| %>
  <div class="mb-5.5 flex flex-col gap-4">
    <label class="flex flex-col gap-1.75">
      <span class="text-13-5 font-medium text-ink-4"><%= t("auth.fields.new_password") %></span>
      <%= form.password_field :password, required: true, autofocus: true, minlength: 8, maxlength: 72,
            autocomplete: "new-password", placeholder: "••••••••",
            class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3.75 py-3.25 text-15 text-ink
                    transition-colors outline-none placeholder:text-muted-3 focus:border-brand-ink" %>
      <span class="text-12-5 text-muted-2"><%= t("auth.fields.password_hint") %></span>
    </label>

    <label class="flex flex-col gap-1.75">
      <span class="text-13-5 font-medium text-ink-4"><%= t("auth.fields.new_password_confirmation") %></span>
      <%= form.password_field :password_confirmation, required: true, minlength: 8, maxlength: 72,
            autocomplete: "new-password", placeholder: "••••••••",
            class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3.75 py-3.25 text-15 text-ink
                    transition-colors outline-none placeholder:text-muted-3 focus:border-brand-ink" %>
    </label>
  </div>

  <%= form.submit t("auth.reset.submit"),
        class: "mb-4 w-full cursor-pointer rounded-[12px] bg-brand py-3.5 text-15-5 font-semibold text-white
                transition-colors hover:bg-brand-deep" %>
<% end %>

<p class="mt-6.5 text-13-5 leading-[1.6] text-balance text-muted-2"><%= t("auth.reset.help") %></p>
