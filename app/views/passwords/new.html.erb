<% content_for :title, "#{t("auth.forgot.title")} — UTCC AI Academy" %>

<%# Forgot-password drops the tabs for a back link, as the design does. %>
<%= link_to t("auth.back"), login_path,
      class: "mb-5.5 inline-block text-13-5 text-muted hover:text-ink" %>

<h1 class="mb-2 text-28 leading-[1.2] font-bold tracking-[-0.025em]"><%= t("auth.forgot.title") %></h1>
<p class="mb-7 text-15 leading-[1.6] text-balance text-muted"><%= t("auth.forgot.subtitle") %></p>

<%# PasswordsController#create redirects back here with ?sent=1 whatever the
    address was: saying "sent" for an address with no account is what keeps the
    form from confirming who has one. %>
<% if params[:sent] %>
  <div role="status"
       class="mb-5.5 rounded-[13px] border border-success-line bg-success-tint px-5 py-4.5">
    <p class="mb-1.25 text-14-5 font-bold text-success-deep"><%= t("auth.forgot.sent_title") %></p>
    <p class="text-14-5 leading-[1.6] text-ink-4"><%= t("auth.forgot.sent_body") %></p>
  </div>
<% end %>

<%= form_with url: forgot_password_path do |form| %>
  <div class="mb-5.5 flex flex-col gap-4">
    <label class="flex flex-col gap-1.75">
      <span class="text-13-5 font-medium text-ink-4"><%= t("auth.fields.email") %></span>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", placeholder: "you@utcc.ac.th",
            value: params[:email_address],
            class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3.75 py-3.25 text-15 text-ink
                    transition-colors outline-none placeholder:text-muted-3 focus:border-brand" %>
    </label>
  </div>

  <%= form.submit t("auth.forgot.submit"),
        class: "mb-4 w-full cursor-pointer rounded-[12px] bg-brand py-3.5 text-15-5 font-semibold text-white
                transition-colors hover:bg-brand-deep" %>
<% end %>

<p class="mt-6.5 text-13-5 leading-[1.6] text-balance text-muted-2"><%= t("auth.forgot.help") %></p>
