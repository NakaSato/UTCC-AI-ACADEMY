<%# The one screen on which somebody other than an author reads a proposal.
    A row carries what the decision needs — who wrote it, what they asked for,
    and what has been said back — and the form is a status and a reason, because
    ADR-0049 decision 5 says a decision is a record and decision 4 says the
    reason is what the author reads. There is no internal note: a second field
    would immediately raise the question this increment is not answering. %>
<div class="flex flex-col gap-3.5">
  <% if @proposals.empty? %>
    <div class="rounded-card border border-dashed border-hairline-2 bg-surface px-6 py-10 text-center">
      <p class="text-15 font-medium text-ink"><%= t("admin.proposals.empty") %></p>
    </div>
  <% else %>
    <% @proposals.each do |proposal| %>
      <% decision = proposal.decisions.max_by(&:created_at) %>
      <div class="rounded-box border border-hairline-2 bg-surface px-6 py-5" data-proposal-id="<%= proposal.id %>">
        <div class="mb-1.75 flex flex-wrap items-center gap-2.25">
          <span class="font-mono text-11-5 font-semibold text-brand-ink-deep"><%= proposal.reference %></span>
          <span class="rounded-full bg-surface-2 px-2.25 py-0.75 text-11-5 font-semibold text-muted-2">
            <%= t("proposal_request.categories.#{proposal.category}") %>
          </span>
          <span class="rounded-full <%= proposal.decided? ? "bg-surface-2 text-muted-2" : "bg-success-tint text-success-deep" %>
                       px-2.25 py-0.75 text-11-5 font-semibold tracking-[0.04em] uppercase">
            <%= t("proposal_request.status.#{proposal.status}") %>
          </span>
          <span class="font-mono text-11-5 text-muted-3"><%= l(proposal.created_at, format: :short) %></span>
        </div>

        <div class="mb-1 text-16 font-semibold tracking-[-0.01em]"><%= proposal.title %></div>
        <div class="text-13-5 text-muted"><%= t("admin.proposals.author", name: proposal.user.name) %></div>

        <dl class="mt-3 flex flex-col gap-2 text-13-5">
          <% { problem: proposal.problem, idea: proposal.idea, impact: proposal.impact }.each do |field, value| %>
            <div>
              <dt class="text-11-5 font-semibold tracking-[0.08em] text-muted-3 uppercase"><%= t("proposal_request.fields.#{field}") %></dt>
              <dd class="mt-0.5 leading-[1.6] text-ink-2"><%= value %></dd>
            </div>
          <% end %>
        </dl>

        <% if decision %>
          <div class="mt-3.5 rounded-field border border-hairline bg-surface-2 px-4 py-3">
            <p class="text-11-5 font-semibold tracking-[0.08em] text-muted-3 uppercase">
              <%= t("admin.proposals.told_author", status: t("proposal_request.status.#{decision.to_status}")) %>
            </p>
            <p class="mt-1 text-13-5 leading-[1.6] text-ink-2"><%= decision.reason %></p>
          </div>
        <% end %>

        <% if proposal.decidable_by?(Current.user) %>
          <%= form_with url: admin_proposal_decision_path(proposal), method: :post,
                class: "mt-4 flex flex-wrap items-end gap-2.5 border-t border-hairline-2 pt-4" do |form| %>
            <label class="flex flex-col gap-1">
              <span class="text-11-5 font-semibold tracking-[0.08em] text-muted-3 uppercase"><%= t("admin.proposals.decision") %></span>
              <%= form.select :status,
                    ProposalRequest::TRANSITIONS.fetch(proposal.status).map { [ t("proposal_request.status.#{it}"), it ] },
                    {}, class: "rounded-lg border border-hairline-2 bg-surface px-3 py-2 text-13 text-ink" %>
            </label>
            <%# The reason is the text its author reads (SPEC-0050), and it is
                the only field here with a limit somebody can reach. The counter
                is a Vue island over the field rather than beside it in Ruby,
                because the number changes as they type — ADR-0051. The field id
                is written once and passed in, so the two cannot drift. %>
            <% reason_field_id = "proposal_#{proposal.id}_reason" %>
            <label class="flex min-w-[260px] flex-1 flex-col gap-1">
              <span class="text-11-5 font-semibold tracking-[0.08em] text-muted-3 uppercase"><%= t("admin.proposals.reason") %></span>
              <%= form.text_field :reason, required: true, maxlength: 1000, size: nil, id: reason_field_id,
                    placeholder: t("admin.proposals.reason_placeholder"),
                    class: "w-full rounded-lg border border-hairline-2 bg-surface px-3 py-2 text-13 text-ink" %>
              <div data-vue-island="character-counter"
                   data-vue-island-props="<%= { fieldId: reason_field_id, max: 1000,
                                                template: t("forms.characters_left") }.to_json %>"></div>
            </label>
            <%= form.submit t("admin.proposals.record"),
                  class: "rounded-full bg-brand px-3.5 py-2 text-12 font-semibold text-white hover:bg-brand-deep" %>
          <% end %>
        <% else %>
          <p class="mt-4 border-t border-hairline-2 pt-4 text-13-5 text-muted-2"><%= t("admin.proposals.answered") %></p>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/pagination", page: @proposals %>
</div>
