<div class="overflow-x-auto rounded-card border border-hairline bg-surface">
  <div class="flex items-baseline justify-between gap-4 px-6.5 pt-5.5 pb-4">
    <h2 class="text-19 font-bold tracking-[-0.02em]"><%= t("admin.audit.title") %></h2>
    <span class="text-13 text-muted-2"><%= t("admin.audit.sub") %></span>
  </div>

  <div class="min-w-[700px]">
    <% AdminConsole.audit.each do |row| %>
      <div class="grid grid-cols-[132px_168px_minmax(0,1fr)_150px] items-center gap-4
                  border-t border-surface-5 px-6.5 py-3.25">
        <span class="font-mono text-12 text-muted-2"><%= row[:stamp] %></span>
        <span class="text-13-5 text-ink-2"><%= row[:actor] %></span>
        <span class="text-13-5 text-muted"><%= row[:event] %></span>
        <span class="text-right text-11-5 font-semibold tracking-[0.04em] uppercase
                     <%= row[:level] == :warn ? "text-gold-ink" : "text-muted-3" %>">
          <%= t("admin.audit.levels.#{row[:level]}") %>
        </span>
      </div>
    <% end %>
  </div>
</div>
