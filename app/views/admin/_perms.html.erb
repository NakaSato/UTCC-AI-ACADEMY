<%# The capability × role matrix. Every row is a true statement about the code
    — see AdminConsole::PERMS, which is where a changed gate must be reflected.
    Static marks, not toggles: the gates live in `allow_only` declarations, and
    a switch here would be a second copy free to disagree. %>
<section class="overflow-hidden rounded-card border border-hairline bg-surface">
  <div class="px-6.5 pt-5.5 pb-4">
    <h2 class="mb-1.25 text-19 font-bold tracking-[-0.02em]"><%= t("admin.perms.title") %></h2>
    <p class="text-13 text-balance text-muted-2"><%= t("admin.perms.sub") %></p>
  </div>

  <div class="overflow-x-auto">
    <div class="min-w-[640px]">
      <div class="grid grid-cols-[minmax(0,1fr)_repeat(3,110px)] items-center border-y border-surface-3 bg-surface-4
                  px-6.5 py-3 text-12 font-semibold tracking-[0.05em] text-muted-2 uppercase">
        <span><%= t("admin.perms.cap") %></span>
        <% User::ROLES.each do |role| %>
          <span class="text-center"><%= t("admin.roles.#{role}") %></span>
        <% end %>
      </div>

      <% AdminConsole.perm_rows.each do |row| %>
        <div class="grid grid-cols-[minmax(0,1fr)_repeat(3,110px)] items-center border-b border-surface-5 px-6.5 py-3.25">
          <span class="text-14-5"><%= row[:label] %></span>
          <% row[:flags].each do |allowed| %>
            <span class="grid place-items-center">
              <% if allowed %>
                <span aria-hidden="true"
                      class="grid size-5 place-items-center rounded-md bg-success text-12 leading-none text-white">✓</span>
                <span class="sr-only"><%= t("admin.perms.yes") %></span>
              <% else %>
                <span aria-hidden="true" class="text-13 text-muted-4">—</span>
                <span class="sr-only"><%= t("admin.perms.no") %></span>
              <% end %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
