<%# The one tab backed by real records. Roles persist; nothing else here does.
    The chips and the search are query-string state like every other filter in
    the app — a filtered roster is a URL. %>
<div class="mb-4 flex flex-wrap items-center gap-2">
  <% AdminConsole::ROLE_FILTERS.each do |chip| %>
    <% current = chip == @role %>
    <%= link_to chip == :all ? t("admin.filter_all") : t("admin.roles.#{chip}"),
          admin_path(tab: :users, role: (chip unless chip == :all), q: @query.presence),
          class: class_names(
            "rounded-full border-[1.5px] px-3.75 py-1.75 text-13-5 font-medium transition-colors",
            "border-brand-ink bg-brand-tint text-brand-ink-deep" => current,
            "border-hairline bg-surface text-ink-2 hover:border-muted-3" => !current
          ) %>
  <% end %>

  <% if FeatureSetting.enabled?(:search) %>
    <%= form_with url: admin_path, method: :get, class: "ml-auto flex min-w-[240px] flex-1 sm:flex-none" do %>
      <%= hidden_field_tag :tab, :users %>
      <%= hidden_field_tag :role, @role unless @role == :all %>
      <%= search_field_tag :q, @query, placeholder: t("admin.users_search_ph"),
            "aria-label": t("admin.users_search_ph"),
            class: "w-full rounded-field border-[1.5px] border-hairline-2 bg-surface px-3.5 py-2.25 text-14
                    text-ink transition-colors outline-none placeholder:text-muted-3 focus:border-brand-ink" %>
    <% end %>
  <% end %>
</div>

<%# Where console accounts come from. Sign-up only ever produces a learner, so an
    instructor, an administrator, or a company member is made here. No student ID
    field: these accounts are named by username and email. %>
<section class="mb-4 overflow-hidden rounded-card border border-hairline bg-surface">
  <div class="px-6 pt-5.5 pb-1">
    <h2 class="text-19 font-bold tracking-[-0.02em]"><%= t("admin.console_account.title") %></h2>
    <p class="mt-1 text-13-5 leading-[1.6] text-muted"><%= t("admin.console_account.subtitle") %></p>
  </div>

  <%= form_with url: admin_console_accounts_path, class: "flex flex-col gap-3 px-6 py-5" do %>
    <div class="grid gap-3 sm:grid-cols-3">
      <label class="flex flex-col gap-1.5">
        <span class="text-13 font-medium text-ink-4"><%= t("admin.console_account.name") %></span>
        <%= text_field_tag "console_account[name]", nil, required: true, maxlength: 60,
              class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3 py-2 text-14 text-ink
                      transition-colors outline-none focus:border-brand-ink" %>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="text-13 font-medium text-ink-4"><%= t("admin.console_account.username") %></span>
        <%= text_field_tag "console_account[username]", nil, maxlength: 30,
              spellcheck: false, autocapitalize: "off", placeholder: "wichai",
              class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3 py-2 text-14 text-ink
                      transition-colors outline-none focus:border-brand-ink" %>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="text-13 font-medium text-ink-4"><%= t("admin.console_account.email") %></span>
        <%# Required, unlike on sign-up: an address is a console account's only
            self-service way back in. See AdminController. %>
        <%= email_field_tag "console_account[email_address]", nil, required: true, maxlength: 255,
              spellcheck: false, autocapitalize: "off", placeholder: "you@utcc.ac.th",
              class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3 py-2 text-14 text-ink
                      transition-colors outline-none focus:border-brand-ink" %>
      </label>
    </div>

    <div class="grid gap-3 sm:grid-cols-3">
      <label class="flex flex-col gap-1.5">
        <span class="text-13 font-medium text-ink-4"><%= t("admin.console_account.access_label") %></span>
        <%= select_tag :access,
              options_for_select(AdminConsole::CONSOLE_ACCESS.map { [ t("admin.console_account.access.#{it}"), it ] }),
              class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3 py-2 text-14 text-ink
                      transition-colors outline-none focus:border-brand-ink" %>
      </label>

      <%# Both are read only when access is "company" — see the controller. %>
      <label class="flex flex-col gap-1.5">
        <span class="text-13 font-medium text-ink-4"><%= t("admin.console_account.organization") %></span>
        <%= select_tag :organization_id,
              options_from_collection_for_select(@organizations, :id, :name),
              include_blank: t("admin.console_account.no_organization"),
              class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3 py-2 text-14 text-ink
                      transition-colors outline-none focus:border-brand-ink" %>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="text-13 font-medium text-ink-4"><%= t("admin.console_account.membership_role") %></span>
        <%= select_tag :membership_role,
              options_for_select(OrganizationMembership::ROLES.map { [ t("recruitment.memberships.roles.#{it}"), it ] }),
              class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3 py-2 text-14 text-ink
                      transition-colors outline-none focus:border-brand-ink" %>
      </label>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="max-w-[62ch] text-12-5 leading-[1.6] text-muted-2"><%= t("admin.console_account.password_note") %></p>
      <%= submit_tag t("admin.console_account.submit"),
            class: "rounded-field bg-brand px-4 py-2 text-14 font-semibold whitespace-nowrap text-white
                    transition-colors hover:bg-brand-deep" %>
    </div>
  <% end %>
</section>

<section class="overflow-hidden rounded-card border border-hairline bg-surface">
  <div class="px-6 pt-5.5 pb-4">
    <h2 class="text-19 font-bold tracking-[-0.02em]"><%= t("admin.roster_title") %></h2>
  </div>

  <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-2 border-y border-surface-3 bg-surface-4 px-4 py-3 text-12
              font-semibold tracking-[0.05em] text-muted-2 uppercase
              sm:grid-cols-[136px_minmax(0,1fr)_112px_240px] sm:px-6">
    <span class="hidden sm:block"><%= t("admin.th_id") %></span>
    <span><%= t("admin.th_name") %></span>
    <span class="hidden sm:block"><%= t("admin.th_role") %></span>
    <span class="text-right"><%= t("admin.th_change") %></span>
  </div>

  <% @users.each do |user| %>
    <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2 border-b border-surface-5 px-4 py-3.5
                sm:grid-cols-[136px_minmax(0,1fr)_112px_240px] sm:px-6">
      <span class="hidden font-mono text-12-5 text-muted sm:block"><%= user.identifier %></span>

      <span class="truncate text-14-5">
        <%= user.name %>
        <span class="ml-1 text-12-5 text-muted-2 sm:hidden"><%= user.identifier %></span>
      </span>

      <span class="hidden sm:block">
        <span class="rounded-full px-2.75 py-1 text-12-5 font-semibold
                     <%= class_names(
                           "bg-brand-tint text-brand-ink-deep" => user.admin?,
                           "bg-gold-tint text-gold-ink" => user.instructor?,
                           "bg-surface-2 text-ink-4" => user.student?
                         ) %>">
          <%= t("admin.roles.#{user.role}") %>
        </span>
      </span>

      <%# An admin cannot change their own role, so their row offers no control
          rather than a button the action would refuse. %>
      <% if user == Current.user %>
        <span class="text-right text-13-5 text-muted-2"><%= t("admin.role_self") %></span>
      <% else %>
        <div class="flex flex-wrap justify-end gap-2">
          <%# Console accounts only: a learner resets their own password by email,
              which reaches them without an admin reading the new one. %>
          <% if user.console_access? %>
            <%= button_to t("admin.console_account.reissue"), admin_user_password_path(user),
                  form: { data: { turbo_confirm: t("admin.console_account.reissue_confirm", name: user.name) } },
                  class: "cursor-pointer rounded-field border-[1.5px] border-hairline-2 bg-surface px-3 py-2 text-14
                          font-medium whitespace-nowrap text-ink-2 transition-colors hover:border-muted-3" %>
          <% end %>

          <%= form_with url: admin_user_path(user), method: :patch, class: "flex gap-2" do %>
            <%= select_tag :role,
                  options_for_select(User::ROLES.map { [ t("admin.roles.#{it}"), it ] }, user.role),
                  "aria-label": t("admin.role_for", name: user.name),
                  class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3 py-2 text-14 text-ink
                          transition-colors outline-none focus:border-brand-ink" %>
            <%= submit_tag t("admin.save"),
                  class: "rounded-field bg-brand px-4 py-2 text-14 font-semibold whitespace-nowrap text-white
                          transition-colors hover:bg-brand-deep" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
