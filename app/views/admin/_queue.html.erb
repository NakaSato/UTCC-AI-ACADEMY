<div class="grid grid-cols-1 items-start gap-5 nav:grid-cols-[minmax(0,1fr)_320px]">
  <div class="flex flex-col gap-3.5">
    <% if AdminConsole.queue.empty? %>
      <div class="rounded-card border border-dashed border-hairline-2 bg-surface px-6 py-10 text-center">
        <p class="text-15 font-medium text-ink"><%= t("admin.queue.empty") %></p>
      </div>
    <% else %>
      <% AdminConsole.queue.each do |request| %>
        <div class="flex flex-wrap items-center gap-5 rounded-box border border-hairline-2 bg-surface px-6 py-5"
             data-approval-request-id="<%= request.id %>">
          <div class="min-w-0 flex-1">
            <div class="mb-1.75 flex flex-wrap items-center gap-2.25">
              <span class="rounded-full bg-success-tint px-2.25 py-0.75 text-11-5 font-semibold tracking-[0.04em] text-success-deep uppercase">
                <%= t("admin.queue.kind.course") %>
              </span>
              <span class="font-mono text-11-5 text-muted-3"><%= l(request.created_at, format: :short) %></span>
              <span class="rounded-full bg-surface-2 px-2.25 py-0.75 text-11-5 font-semibold text-muted-2">
                <%= t("admin.queue.status.#{request.status}") %>
              </span>
            </div>
            <div class="mb-1 text-16 font-semibold tracking-[-0.01em]"><%= request.title %></div>
            <div class="text-13-5 text-muted">
              <%= t("admin.queue.request_meta", role: request.requester_role, from: t("admin.courses.state.#{request.from_state}"), to: t("admin.courses.state.#{request.to_state}")) %>
            </div>
            <% if request.note.present? %>
              <p class="mt-2 text-13 text-muted-2"><%= request.note %></p>
            <% end %>
          </div>

          <% if request.approvable_by?(Current.user) %>
            <div class="flex flex-none gap-2">
              <%= button_to t("admin.queue.approve"), admin_approval_decision_path(request),
                    method: :post, params: { outcome: "approved" },
                    class: "rounded-full bg-brand px-3.5 py-2 text-12 font-semibold text-white hover:bg-brand-deep" %>
              <%= button_to t("admin.queue.reject"), admin_approval_decision_path(request),
                    method: :post, params: { outcome: "rejected" },
                    class: "rounded-full border border-hairline-2 px-3.5 py-2 text-12 font-semibold text-ink-2 hover:border-brand hover:text-brand-deep" %>
            </div>
          <% elsif request.pending? %>
            <span class="flex-none rounded-[10px] border border-hairline bg-surface-4 px-4.5 py-2.5 text-13-5 font-medium text-muted-2">
              <%= request.requester_id == Current.user.id ? t("admin.queue.self_review") : t("admin.queue.pending") %>
            </span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <aside class="rounded-card bg-chrome px-7 py-6.5">
    <div class="mb-4 text-12 font-semibold tracking-[0.1em] text-on-chrome-muted uppercase">
      <%= t("admin.queue.sla_title") %>
    </div>
    <div class="text-44 leading-none font-bold tracking-[-0.03em] text-canvas">
      <%= AdminConsole.pending_count %>
    </div>
    <p class="mt-2 text-13-5 text-on-chrome-soft"><%= t("admin.queue.sla_note") %></p>

    <div class="my-5.5 h-px bg-chrome-line"></div>

    <dl class="flex flex-col gap-3.25">
      <% AdminConsole.queue_sla.each do |row| %>
        <div class="flex items-baseline justify-between gap-3">
          <dt class="text-13-5 text-on-chrome"><%= row[:label] %></dt>
          <dd class="text-14 font-semibold text-canvas"><%= row[:value] %></dd>
        </div>
      <% end %>
    </dl>
  </aside>
</div>
