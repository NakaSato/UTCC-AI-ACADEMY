<% content_for :title, t("recruitment.invitation.title") %>

<main id="main" class="mx-auto max-w-page px-4 pt-11 pb-20 sm:px-8">
  <div class="mx-auto max-w-2xl rounded-card border border-hairline bg-surface-1 p-6 sm:p-8">
    <p class="font-mono text-12 text-muted"><%= t("recruitment.invitation.eyebrow") %></p>
    <h1 class="mt-3 text-32 font-bold tracking-[-0.035em] text-ink"><%= t("recruitment.invitation.title") %></h1>
    <p class="mt-3 text-16 leading-relaxed text-muted">
      <%= t("recruitment.invitation.subtitle",
            organization: @invitation.organization.name,
            role: t("recruitment.memberships.roles.#{@invitation.role}")) %>
    </p>
    <p class="mt-4 text-13 text-muted">
      <%= t("recruitment.invitation.expires", date: l(@invitation.expires_at.to_date, format: :long)) %>
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <%= button_to t("recruitment.invitation.accept"),
            recruitment_accept_organization_invitation_path(@invitation.token),
            method: :post,
            class: "rounded-full bg-brand px-5 py-3 text-13 font-semibold text-white transition hover:bg-brand-dark" %>
      <%= button_to t("recruitment.invitation.decline"),
            recruitment_decline_organization_invitation_path(@invitation.token),
            method: :post,
            class: "rounded-full border border-hairline px-5 py-3 text-13 font-semibold text-muted transition hover:border-brand hover:text-brand" %>
    </div>
  </div>
</main>
