<% content_for :title, "#{@application.job_post.title} — UTCC AI Academy" %>

<main id="main" class="mx-auto max-w-page px-4 pt-11 pb-20 sm:px-8">
  <div class="mb-8">
    <%= link_to @organization_view ? t("recruitment.applications.back_to_pipeline") : t("recruitment.applications.back_to_my_applications"), @organization_view ? recruitment_organization_job_post_applications_path(@organization, @job_post) : recruitment_job_applications_path, class: "text-13 font-semibold text-brand hover:underline" %>
    <div class="mt-5 flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-13 text-muted"><%= @application.job_post.organization.name %></p>
        <h1 class="mt-2 text-32 font-bold tracking-[-0.035em] text-ink"><%= @application.job_post.title %></h1>
      </div>
      <span class="rounded-full bg-surface-2 px-3 py-1.5 text-12 font-semibold text-muted"><%= t("recruitment.applications.statuses.#{@application.status}") %></span>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1fr_320px]">
    <article class="rounded-card border border-hairline bg-surface-1 p-6 sm:p-8">
      <% if @candidate_view %>
        <h2 class="text-20 font-semibold text-ink"><%= t("recruitment.applications.next_action_title") %></h2>
        <p class="mt-2 text-14 leading-relaxed text-muted"><%= t("recruitment.applications.next_action", action: t("recruitment.applications.next_actions.#{@application.next_action}")) %></p>
      <% else %>
        <h2 class="text-20 font-semibold text-ink"><%= t("recruitment.applications.candidate_statement") %></h2>
        <p class="mt-3 whitespace-pre-line text-14 leading-relaxed text-muted"><%= @application.statement.presence || t("recruitment.applications.no_statement") %></p>
        <p class="mt-5 text-12 text-muted"><%= t("recruitment.applications.candidate_label", name: @application.candidate.name) %></p>
      <% end %>

  <% if @candidate_view && @application.candidate_withdrawable? %>
        <%= button_to t("recruitment.jobs.withdraw_application"), recruitment_withdraw_job_application_path(@application), method: :post, class: "mt-6 rounded-full border border-hairline px-4 py-2.5 text-13 font-semibold text-brand" %>
      <% end %>

      <% if @candidate_view && @candidate_assistant %>
        <section class="mt-8 rounded-xl border border-brand/20 bg-brand/5 p-5">
          <h2 class="text-20 font-semibold text-ink"><%= t("recruitment.applications.candidate_assistant_title") %></h2>
          <p class="mt-1 text-13 leading-relaxed text-muted"><%= t("recruitment.applications.candidate_assistant_subtitle") %></p>
          <ul class="mt-4 space-y-3">
            <% @candidate_assistant.items.each do |item| %>
              <li class="rounded-xl border border-hairline bg-surface-1 p-3">
                <p class="text-13 font-semibold text-ink"><%= t("recruitment.applications.candidate_assistant_items.#{item.key}") %></p>
                <p class="mt-1 text-11 text-muted"><%= t("recruitment.applications.candidate_assistant_source") %>: <%= item.source %></p>
              </li>
            <% end %>
          </ul>
          <p class="mt-4 text-11 leading-relaxed text-muted"><%= @candidate_assistant.uncertainty %></p>
        </section>
      <% end %>
    </article>

    <aside class="rounded-card border border-hairline bg-surface-1 p-6">
      <h2 class="text-17 font-semibold text-ink"><%= t("recruitment.applications.history_title") %></h2>
      <ol class="mt-4 space-y-4">
        <% @application.events.order(occurred_at: :asc, id: :asc).each do |event| %>
          <li class="border-l-2 border-brand/30 pl-3">
            <p class="text-13 font-semibold text-ink"><%= t("recruitment.applications.statuses.#{event.to_status}") %></p>
            <p class="mt-1 text-11 text-muted"><%= l(event.occurred_at, format: :short) %></p>
            <% if @organization_view && event.note.present? %><p class="mt-2 text-12 text-muted"><%= event.note %></p><% end %>
          </li>
        <% end %>
      </ol>
    </aside>
  </div>

  <section class="mt-6 rounded-card border border-hairline bg-surface-1 p-6">
    <h2 class="text-20 font-semibold text-ink"><%= t("recruitment.applications.messages_title") %></h2>
    <p class="mt-1 text-13 leading-relaxed text-muted"><%= t("recruitment.applications.messages_subtitle") %></p>

    <% if @messages.empty? %>
      <p class="mt-5 rounded-xl bg-surface-2 p-4 text-13 text-muted"><%= t("recruitment.applications.messages_empty") %></p>
    <% else %>
      <ol class="mt-5 space-y-3">
        <% @messages.each do |message| %>
          <li class="rounded-xl border border-hairline bg-surface-2 p-4">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <p class="text-13 font-semibold text-ink"><%= t("recruitment.applications.message_sender", name: message.sender.name) %></p>
              <p class="text-11 text-muted"><%= t("recruitment.applications.message_sent_at", date: l(message.sent_at, format: :short)) %></p>
            </div>
            <p class="mt-2 whitespace-pre-line text-14 leading-relaxed text-muted"><%= message.body %></p>
          </li>
        <% end %>
      </ol>
    <% end %>

    <%= form_with url: @organization_view ? message_recruitment_organization_job_post_application_path(@organization, @job_post, @application) : recruitment_message_job_application_path(@application), scope: :recruitment_job_application_message, method: :post, class: "mt-5 grid gap-3" do |form| %>
      <%= form.label :body, t("recruitment.applications.message_body"), class: "text-13 font-semibold text-ink" %>
      <%= form.text_area :body, maxlength: 4_000, rows: 4, placeholder: t("recruitment.applications.message_placeholder"), class: "rounded-xl border border-hairline bg-surface-2 px-3 py-2.5 text-13 text-ink" %>
      <div>
        <%= form.submit t("recruitment.applications.send_message"), class: "rounded-full bg-brand px-4 py-2.5 text-13 font-semibold text-white" %>
      </div>
    <% end %>
  </section>

  <% if @organization_view && @application.status != "accepted" && @application.status != "rejected" && !@application.withdrawn? %>
    <section class="mt-6 rounded-card border border-hairline bg-surface-1 p-6">
      <h2 class="text-20 font-semibold text-ink"><%= t("recruitment.applications.transition_title") %></h2>
      <%= form_with url: transition_recruitment_organization_job_post_application_path(@organization, @job_post, @application), scope: :recruitment_job_application, method: :post, class: "mt-4 grid gap-3 md:grid-cols-[1fr_1fr_auto]" do |form| %>
        <%= form.select :status, Recruitment::JobApplication::TRANSITIONS.fetch(@application.status).map { |status| [ t("recruitment.applications.statuses.#{status}"), status ] }, {}, class: "rounded-xl border border-hairline bg-surface-2 px-3 py-2.5 text-13 text-ink" %>
        <%= form.text_field :note, size: nil, maxlength: 2_000, placeholder: t("recruitment.applications.note_placeholder"), class: "rounded-xl border border-hairline bg-surface-2 px-3 py-2.5 text-13 text-ink" %>
        <%= form.hidden_field :lock_version, value: @application.lock_version %>
        <%= form.submit t("recruitment.applications.transition"), class: "rounded-full bg-brand px-4 py-2.5 text-13 font-semibold text-white" %>
      <% end %>
    </section>
  <% end %>

  <% if @organization_view && @assistant %>
    <section class="mt-6 rounded-card border border-brand/20 bg-brand/5 p-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 class="text-20 font-semibold text-ink"><%= t("recruitment.applications.assistant_title") %></h2>
          <p class="mt-1 text-13 leading-relaxed text-muted"><%= t("recruitment.applications.assistant_subtitle") %></p>
        </div>
        <span class="rounded-full bg-surface-1 px-3 py-1.5 text-12 font-semibold text-muted"><%= t("recruitment.applications.assistant_actions.#{@assistant.action}") %></span>
      </div>
      <p class="mt-4 text-13 leading-relaxed text-muted"><%= t("recruitment.applications.assistant_attention", attention: t("recruitment.applications.assistant_attention_states.#{@assistant.attention ? "yes" : "no"}")) %></p>
      <dl class="mt-4 grid gap-3 text-12 text-muted sm:grid-cols-3">
        <div><dt class="font-semibold"><%= t("recruitment.applications.assistant_source_status") %></dt><dd class="mt-1"><%= t("recruitment.applications.statuses.#{@application.status}") %></dd></div>
        <div><dt class="font-semibold"><%= t("recruitment.applications.assistant_source_started") %></dt><dd class="mt-1"><%= l(@assistant.stage_started_at, format: :short) %></dd></div>
        <div><dt class="font-semibold"><%= t("recruitment.applications.assistant_source_threshold") %></dt><dd class="mt-1"><%= @assistant.threshold_days ? t("recruitment.applications.assistant_days", count: @assistant.threshold_days) : t("recruitment.applications.assistant_no_threshold") %></dd></div>
      </dl>
      <p class="mt-4 text-11 leading-relaxed text-muted"><%= @assistant.uncertainty %></p>
    </section>
  <% end %>
</main>
