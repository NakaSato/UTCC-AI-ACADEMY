<% content_for :title, "#{t("recruitment.organizations.title")} — UTCC AI Academy" %>

<main id="main" class="mx-auto max-w-page px-4 pt-11 pb-20 sm:px-8">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="mb-2 text-11 font-semibold tracking-[0.14em] text-muted uppercase"><%= t("recruitment.organizations.eyebrow") %></p>
      <h1 class="text-32 font-bold tracking-[-0.035em] text-ink"><%= t("recruitment.organizations.title") %></h1>
      <p class="mt-2 max-w-[58ch] text-14 leading-[1.65] text-muted"><%= t("recruitment.organizations.subtitle") %></p>
    </div>
    <% if Current.user.admin? %>
      <%= link_to t("recruitment.organizations.new"), new_recruitment_organization_path,
            class: "rounded-full bg-brand px-4 py-2.5 text-13 font-semibold text-white transition hover:bg-brand-dark" %>
    <% end %>
  </div>

  <% if @organizations.empty? %>
    <div class="rounded-card border border-dashed border-hairline bg-surface-1 p-8 text-center">
      <h2 class="text-18 font-semibold text-ink"><%= t("recruitment.organizations.empty_title") %></h2>
      <p class="mt-2 text-14 text-muted"><%= t("recruitment.organizations.empty_body") %></p>
    </div>
  <% else %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @organizations.each do |organization| %>
        <%= link_to company_path(organization),
              class: "rounded-card border border-hairline bg-surface-1 p-6 transition hover:border-brand hover:shadow-sm" do %>
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-18 font-semibold text-ink"><%= organization.name %></h2>
              <p class="mt-1 font-mono text-12 text-muted"><%= organization.slug %></p>
            </div>
            <span class="rounded-full bg-surface-2 px-2.5 py-1 text-11 font-semibold text-muted"><%= t("recruitment.organizations.status.#{organization.status}") %></span>
          </div>
          <p class="mt-5 text-13 text-muted"><%= t("recruitment.organizations.member_count", count: organization.memberships.active.count) %></p>
        <% end %>
      <% end %>
    </div>
  <% end %>
</main>
