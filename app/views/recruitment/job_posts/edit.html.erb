<% content_for :title, t("recruitment.jobs.fields.title") %>

<main id="main" class="mx-auto max-w-page px-4 pt-11 pb-20 sm:px-8">
  <div class="mb-8">
    <%= link_to t("recruitment.jobs.back_to_organization"), company_job_posts_path(@organization), class: "text-13 font-semibold text-brand-ink hover:underline" %>
    <h1 class="mt-4 text-32 font-bold tracking-[-0.035em] text-ink"><%= @job_post.title.presence || t("recruitment.jobs.untitled") %></h1>
  </div>
  <%= render "form", organization: @organization, job_post: @job_post, form_url: company_job_post_path(@organization, @job_post), form_method: :patch %>
</main>
