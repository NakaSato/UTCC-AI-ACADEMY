<% content_for :title, "#{@public ? t("recruitment.jobs.public_title") : @organization.name} — UTCC AI Academy" %>

<main id="main" class="mx-auto max-w-page px-4 pt-11 pb-20 sm:px-8">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <% unless @public %>
        <%= link_to t("recruitment.jobs.back_to_organization"), company_path(@organization), class: "text-13 font-semibold text-brand-ink hover:underline" %>
      <% end %>
      <h1 class="mt-3 text-32 font-bold tracking-[-0.035em] text-ink"><%= @public ? t("recruitment.jobs.public_title") : t("recruitment.jobs.management_title") %></h1>
    <p class="mt-2 max-w-2xl text-14 leading-relaxed text-muted"><%= @public ? t("recruitment.jobs.public_subtitle") : t("recruitment.jobs.management_subtitle") %></p>
    <% if @public %>
      <div class="mt-4 flex flex-wrap gap-2">
        <% if Current.user.student? %>
          <%= link_to t("recruitment.jobs.alert_preferences"), edit_recruitment_job_discovery_preferences_path,
                class: "inline-flex rounded-full border border-hairline px-4 py-2 text-13 font-semibold text-brand-ink hover:border-brand-ink" %>
        <% end %>
      </div>
    <% end %>
    </div>
    <% if !@public && @can_create %>
      <%= link_to t("recruitment.jobs.new"), new_company_job_post_path(@organization), class: "rounded-full bg-brand px-5 py-3 text-13 font-semibold text-white transition hover:bg-brand-dark" %>
    <% end %>
  </div>

  <% if @public %>
    <section class="mb-8 rounded-card border border-hairline bg-surface-1 p-5">
      <h2 class="text-16 font-semibold text-ink"><%= t("recruitment.jobs.search_title") %></h2>
      <%= form_with url: recruitment_jobs_path, method: :get, class: "mt-4 grid gap-3 md:grid-cols-2 lg:grid-cols-5" do |form| %>
        <%= form.text_field :query, value: @filters["query"], placeholder: t("recruitment.jobs.search_placeholder"), class: "rounded-xl border border-hairline bg-surface-2 px-3 py-2.5 text-13 text-ink lg:col-span-2" %>
        <%= form.select :category, options_for_select([[t("recruitment.jobs.all_categories"), ""]] + @job_categories.map { |category| [ category, category ] }, @filters["category"]), {}, class: "rounded-xl border border-hairline bg-surface-2 px-3 py-2.5 text-13 text-ink" %>
        <%= form.select :employment_type, options_for_select([[t("recruitment.jobs.all_employment_types"), ""]] + Recruitment::JobPost::EMPLOYMENT_TYPES.map { |type| [ t("recruitment.jobs.employment_types.#{type}"), type ] }, @filters["employment_type"]), {}, class: "rounded-xl border border-hairline bg-surface-2 px-3 py-2.5 text-13 text-ink" %>
        <%= form.select :remote_policy, options_for_select([[t("recruitment.jobs.all_remote_policies"), ""]] + Recruitment::JobPost::REMOTE_POLICIES.map { |policy| [ t("recruitment.jobs.remote_policies.#{policy}"), policy ] }, @filters["remote_policy"]), {}, class: "rounded-xl border border-hairline bg-surface-2 px-3 py-2.5 text-13 text-ink" %>
        <%= form.text_field :location, value: @filters["location"], placeholder: t("recruitment.jobs.location_placeholder"), class: "rounded-xl border border-hairline bg-surface-2 px-3 py-2.5 text-13 text-ink" %>
        <%= form.submit t("recruitment.jobs.search"), class: "rounded-full bg-brand px-4 py-2.5 text-13 font-semibold text-white hover:bg-brand-dark md:col-span-2 lg:col-span-5 lg:justify-self-start" %>
      <% end %>
    </section>

    <% if Current.user.student? && @recommendations.present? %>
      <section class="mb-8 rounded-card border border-brand-ink/20 bg-brand/5 p-5">
        <div>
          <h2 class="text-20 font-semibold text-ink"><%= t("recruitment.jobs.recommendations_title") %></h2>
          <p class="mt-1 text-13 leading-relaxed text-muted"><%= t("recruitment.jobs.recommendations_subtitle") %></p>
        </div>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          <% @recommendations.each do |recommendation| %>
            <article class="rounded-xl border border-hairline bg-surface-1 p-4">
              <h3 class="text-15 font-semibold text-ink"><%= link_to recommendation.job_post.title, recruitment_job_path(recommendation.job_post), class: "hover:text-brand-ink" %></h3>
              <ul class="mt-3 space-y-1 text-12 leading-relaxed text-muted">
                <% recommendation.reasons.each do |reason| %><li>• <%= reason %></li><% end %>
              </ul>
              <p class="mt-3 text-11 leading-relaxed text-muted"><%= recommendation.uncertainty %></p>
              <%= button_to t("recruitment.jobs.dismiss_recommendation"), recruitment_dismiss_job_recommendation_path(recommendation.job_post), method: :post,
                    class: "mt-3 rounded-full border border-hairline px-3 py-2 text-12 font-semibold text-brand-ink hover:border-brand-ink" %>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>

  <% if @job_posts.empty? %>
    <section class="rounded-card border border-dashed border-hairline bg-surface-1 px-6 py-12 text-center">
      <h2 class="text-20 font-bold text-ink"><%= @public ? t("recruitment.jobs.empty_public") : t("recruitment.jobs.empty") %></h2>
    </section>
  <% else %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @job_posts.each do |job_post| %>
        <article class="rounded-card border border-hairline bg-surface-1 p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-12 text-muted"><%= @public ? job_post.organization.name : job_post.category %></p>
              <h2 class="mt-1 text-20 font-semibold text-ink"><%= link_to job_post.title.presence || t("recruitment.jobs.untitled"), @public ? recruitment_job_path(job_post) : company_job_post_path(@organization, job_post), class: "hover:text-brand-ink" %></h2>
            </div>
            <% unless @public %>
              <span class="rounded-full bg-surface-2 px-3 py-1 text-12 font-semibold text-muted"><%= t("recruitment.jobs.status.#{job_post.status}") %></span>
            <% end %>
          </div>
          <p class="mt-4 line-clamp-3 text-14 leading-relaxed text-muted"><%= job_post.summary %></p>
          <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-12 text-muted">
            <span><%= job_post.location %></span>
            <span><%= t("recruitment.jobs.employment_types.#{job_post.employment_type}") %></span>
            <span><%= t("recruitment.jobs.remote_policies.#{job_post.remote_policy}") %></span>
          </div>
          <% if @public && Current.user.student? %>
            <div class="mt-5">
              <% if @saved_job_ids.include?(job_post.id) %>
                <%= button_to t("recruitment.jobs.unsave"), recruitment_unsave_job_path(job_post), method: :delete, class: "rounded-full border border-brand-ink px-3 py-2 text-12 font-semibold text-brand-ink" %>
              <% else %>
                <%= button_to t("recruitment.jobs.save_job"), recruitment_save_job_path(job_post), method: :post, class: "rounded-full bg-brand px-3 py-2 text-12 font-semibold text-white" %>
              <% end %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  <% end %>
</main>
