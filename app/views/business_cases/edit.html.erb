<% content_for :title, "#{t("business_cases.edit")} — UTCC AI Academy" %>

<main id="main" class="mx-auto max-w-page px-4 pt-11 pb-20 sm:px-8">
  <div class="mb-8">
    <%= link_to t("business_cases.back"), business_case_path(@business_case),
          class: "text-13 font-semibold text-brand-ink hover:underline" %>
    <h1 class="mt-5 text-32 font-bold tracking-[-0.035em] text-ink"><%= t("business_cases.edit") %></h1>
  </div>

  <%= render "form", business_case: @business_case, url: business_case_path(@business_case), organizations: nil %>
</main>
