<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="<%= theme_class %>">
  <head>
    <%= render "shared/head" %>

    <%# The Vue island bundle, and the only thing Vite builds (ADR-0053). The
        rest of the application's JavaScript is the import map, in
        `shared/head`. `defer` because islands enhance markup that already
        rendered, so nothing waits on this; `nonce` because `script-src` is
        `:self` plus a per-request nonce and a tag without one does not run.
        `vite_client_tag` is the HMR client and emits nothing outside
        development. %>
    <%= vite_client_tag nonce: true %>
    <%= vite_javascript_tag "islands", defer: true, nonce: true %>
  </head>

  <body class="bg-canvas font-sans text-16 leading-body text-ink antialiased">
    <a href="#main"
       class="absolute -top-full left-4 z-50 rounded-field bg-surface px-4 py-2 text-brand-ink-deep shadow-lg transition-[top] duration-300 focus:top-2">
      <%= t("chrome.skip_to_content") %>
    </a>

    <%= authenticated? ? render("shared/app_header") : render("shared/header") %>

    <%= render "shared/flashes" %>
    <%= render "shared/toasts" %>

    <%= yield %>

    <%= render "shared/footer" %>
  </body>
</html>
