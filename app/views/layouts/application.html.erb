<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render "shared/head" %>
  </head>

  <body class="bg-canvas font-sans text-16 leading-body text-ink antialiased">
    <a href="#main"
       class="absolute -top-full left-4 z-50 rounded-field bg-surface px-4 py-2 text-brand-deep shadow-lg transition-[top] duration-300 focus:top-2">
      <%= t("chrome.skip_to_content") %>
    </a>

    <%= authenticated? ? render("shared/app_header") : render("shared/header") %>

    <%= render "shared/flashes" %>

    <%= yield %>

    <%= render "shared/footer" %>
  </body>
</html>
