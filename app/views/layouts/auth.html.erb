<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="<%= theme_class %>">
  <head>
    <%= render "shared/head" %>

    <%# robots.txt stops the crawl; this stops the indexing. A disallowed path
        linked from somewhere else can still be listed as a bare URL, and a
        sign-in form is never the answer to anything anyone searched for. Every
        screen on this layout is one — see CrawlersController::DISALLOWED. %>
    <meta name="robots" content="noindex, nofollow">
  </head>

  <%# The auth screens carry no app chrome: the ink panel on the left is the
      whole brand, and the form owns the right half. %>
  <body data-controller="page-motion"
        class="bg-canvas font-sans text-16 leading-body text-ink antialiased">
    <main id="main" class="grid min-h-screen lg:grid-cols-2">
      <%# @auth_scope is set only by the console screen; the student screens leave
          it nil and take the partial's default. %>
      <%= render "shared/auth_hero", scope: @auth_scope || "auth" %>

      <div class="grid place-items-center px-6 py-14 sm:px-10 lg:px-16">
        <div class="w-full max-w-[420px]">
          <%= render "shared/flashes" %>
          <%= yield %>
        </div>
      </div>
    </main>
  </body>
</html>
