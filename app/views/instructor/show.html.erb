<%# The Teaching console. The cohort figures and the export stay above the bar,
    because they answer "how is the section doing?" whichever panel is open; the
    four panels below are what a teacher came to do, one at a time. %>
<% content_for :title,
     "#{@section ? t("instructor.title", course: @section.course.code) : t("instructor.no_section.title")} — UTCC AI Academy" %>

<main id="main" class="mx-auto max-w-page px-4 pt-11 pb-20 sm:px-8">
  <%# Staff with nothing to teach, and no section to fall back on. Every figure
      below is an average over a roster, so there is nothing honest to show. %>
  <% if @section.nil? %>
    <h1 class="mb-1.5 text-30 font-bold tracking-[-0.03em] sm:text-38"><%= t("instructor.no_section.title") %></h1>
    <p class="max-w-[52ch] text-16 text-balance text-muted"><%= t("instructor.no_section.body") %></p>
  <% else %>
    <div class="mb-7.5 flex flex-wrap items-end justify-between gap-6">
      <div>
        <h1 class="mb-1.5 text-30 font-bold tracking-[-0.03em] sm:text-38">
          <%= t("instructor.title", course: @section.course.code) %>
        </h1>
        <p class="text-16 text-muted">
          <%= t("instructor.subtitle", section: @section.code, count: @report.size, term: @section.term_text) %>
        </p>
      </div>
      <%# A real download since the roster became real rows — see
          InstructorController#grades. data-turbo false: Turbo intercepting a
          file response would swap the body with CSV. %>
      <%= link_to t("instructor.export_csv"), instructor_grades_path, data: { turbo: false },
            class: "rounded-field bg-brand px-5.5 py-3 text-14-5 font-semibold whitespace-nowrap text-white
                    transition-colors hover:bg-brand-deep" %>
    </div>

    <div class="mb-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
      <%# Same card, same entrance as the console's overview tiles: the design
          gives these an upward rise, staggered so the row reads left to right. %>
      <% @report.stats.each_with_index do |stat, index| %>
        <div class="animate-rise rounded-box border border-hairline bg-surface px-6 py-5.5"
             style="animation-delay: <%= index * 45 %>ms">
          <div class="mb-2 text-12-5 font-medium text-muted-2"><%= stat[:label] %></div>
          <div class="text-30 leading-none font-bold tracking-[-0.03em]"><%= stat[:value] %></div>
          <div class="mt-1.75 text-12-5 text-muted-2"><%= stat[:note] %></div>
        </div>
      <% end %>
    </div>

    <%# Tabs are links, like every other tabbed screen — the URL is the state. %>
    <nav class="mb-6.5 flex gap-0.5 overflow-x-auto border-b border-hairline"
         aria-label="<%= t("instructor.title", course: @section.course.code) %>">
      <% @tabs.each do |tab| %>
        <% current = tab == @tab %>
        <% badge = @badges[tab] %>
        <%= link_to instructor_path(tab: (tab unless tab == TeachingConsole::DEFAULT_TAB)),
              "aria-current": ("page" if current),
              class: class_names(
                "-mb-px flex flex-none items-center gap-2 border-b-2 px-3.5 py-3 text-14 transition-colors",
                "border-brand-ink font-semibold text-ink" => current,
                "border-transparent text-muted hover:text-ink" => !current
              ) do %>
          <span><%= t("instructor.tabs.#{tab}") %></span>
          <% if badge&.positive? %>
            <span class="rounded-full px-1.75 py-0.5 text-11-5 font-semibold
                         <%= current ? "bg-brand text-white" : "bg-surface-2 text-muted-2" %>">
              <%= badge %>
            </span>
          <% end %>
        <% end %>
      <% end %>
    </nav>

    <%= render "instructor/#{@tab}" %>
  <% end %>
</main>
