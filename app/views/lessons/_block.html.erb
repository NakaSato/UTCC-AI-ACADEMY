<%#
  One free-form theory block. The design has seven types; which one renders is
  the block's `type`, and every type reads its prose from the same `value`.

  The equation type renders its copy in monospace, and that is the rendering
  rather than a fallback: none of the twelve equation blocks is LaTeX. They are
  plain-text formulas in the reader's own language — "input + model → output →
  evaluation", "MAE = mean(|actual - predicted|)", and their Thai counterparts —
  and typesetting them would make them worse, not better. KaTeX would italicise
  every word as a variable and choke on → and ×.

  This comment used to say KaTeX was unavailable because the app vendored no CSS
  or fonts. That has been untrue for a while: katex.js, katex.css and twenty
  font files are vendored, the stylesheet is in shared/_head, and the
  academic-post editor typesets with them through @tiptap/extension-mathematics.
  Math is rendered in this application — in the one place authors write LaTeX.

  So the day an equation block *is* LaTeX, this branch needs wiring up rather
  than the library needing installing. `placeholder_content_test.rb` fails on
  that day and says so.
%>
<% case block.type %>
<% when :heading %>
  <h2 class="text-22 leading-[1.3] font-bold tracking-[-0.02em]"><%= block.value %></h2>

<% when :text %>
  <p class="max-w-[66ch] text-16-5 leading-[1.75] text-balance text-ink-2"><%= block.value %></p>

<% when :callout %>
  <div class="rounded-xl border border-brand-line border-l-[3px] border-l-brand bg-brand-tint
              px-5.5 py-4.5 text-15-5 leading-[1.7] text-balance text-ink-4">
    <%= block.value %>
  </div>

<% when :equation %>
  <div class="overflow-x-auto rounded-xl border border-surface-3 bg-surface-4 px-6 py-5 text-center">
    <%# Typeset when the copy is LaTeX, printed when it is not — `Block#latex?`
        decides, and the source is what the server sends either way. KaTeX
        replaces it in place, so a reader with no JavaScript sees the
        expression rather than an empty plate. %>
    <span class="font-mono text-14 text-ink-4"
          <% if block.latex? %>data-controller="katex" data-katex-source-value="<%= block.value %>"<% end %>><%= block.value %></span>
  </div>

<% when :code %>
  <div class="overflow-hidden rounded-xl bg-chrome">
    <div class="flex items-center gap-2.25 border-b border-chrome-3 px-4 py-2.5">
      <span aria-hidden="true" class="size-2 flex-none rounded-full bg-brand"></span>
      <span class="font-mono text-11-5 text-on-chrome-2"><%= block.extra %></span>
    </div>
    <pre class="overflow-x-auto px-4.5 py-4 font-mono text-13 leading-[1.75] text-code"><%= block.value %></pre>
  </div>

<% when :link %>
  <%= link_to block.extra, target: "_blank", rel: "noopener",
        class: "flex items-center justify-between gap-4 rounded-xl border border-hairline bg-surface
                px-5 py-3.75 transition-colors hover:border-brand-ink" do %>
    <span class="min-w-0">
      <span class="block text-15 font-semibold text-ink"><%= block.value %></span>
      <span class="mt-0.75 block truncate font-mono text-11-5 text-muted-2"><%= block.extra %></span>
    </span>
    <span class="flex-none text-13 font-semibold text-brand-ink"><%= t("lesson.theory.open_link") %></span>
  <% end %>

<% when :image %>
  <% if block.image? %>
    <figure>
      <%# A background-image plate rather than an <img>: the design crops to a
          fixed band, and the caption below already names the picture. %>
      <div role="img" aria-label="<%= block.value %>"
           class="h-70 w-full rounded-xl border border-hairline bg-surface-2 bg-cover bg-center"
           style="background-image: url(<%= block.extra %>)"></div>
      <figcaption class="mt-2 text-12-5 text-muted-2"><%= block.value %></figcaption>
    </figure>
  <% end %>
<% end %>
