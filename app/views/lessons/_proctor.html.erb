<%#
  The proctoring bar, and the guard that covers the lesson when the learner
  leaves the window. Student proctoring is always on and has no lesson-page
  toggle. Staff are never monitored — see Proctoring for what this does and
  does not do.

  The controller lives on <main>, so the integrity band set there drives the
  colours here through group-data variants.
%>
<div class="mb-5 flex flex-wrap items-center gap-4 rounded-[16px] border border-hairline bg-surface px-5 py-3.5">
  <% unless monitored %>
    <span class="flex-none rounded-full border border-hairline-2 bg-surface-2 px-3 py-1.25
                 text-13-5 font-semibold whitespace-nowrap text-muted">
      <%= t("lesson.proctor.label_exempt") %>
    </span>
    <span class="flex-1 text-13-5 text-balance text-muted"><%= t("lesson.proctor.note_exempt") %></span>
  <% end %>

  <div class="flex flex-none items-center gap-3">
    <div class="h-1.75 w-23 overflow-hidden rounded-full bg-surface-2">
      <div data-proctor-target="meter" data-integrity-meter
           class="h-full rounded-full
                  group-data-[band=clean]:bg-success group-data-[band=review]:bg-gold
                  group-data-[band=risk]:bg-brand"
           style="width: <%= Proctoring::START_SCORE %>%"></div>
    </div>
    <span data-proctor-target="score" data-integrity-score
          class="text-13-5 font-bold group-data-[band=clean]:text-success-deep
                 group-data-[band=review]:text-gold group-data-[band=risk]:text-brand-ink">
      <%= Proctoring::START_SCORE %>
    </span>
    <span data-proctor-target="verdict" data-integrity-verdict class="text-13 text-muted-2">
      <%= t("lesson.proctor.verdict_clean") %>
    </span>
  </div>
</div>

<% if monitored %>
  <%# Shown purely by the data attribute the controller sets on <main>, so with
      no JS it never appears and the lesson stays readable. %>
  <div data-proctor-target="guard" data-integrity-guard
       class="fixed inset-0 z-90 hidden place-items-center bg-chrome/72 p-8
              group-data-[proctor-hidden=true]:grid">
    <div data-proctor-target="guardDialog" data-integrity-guard-dialog
         class="max-w-[460px] rounded-panel bg-surface px-10.5 py-9.5 text-center">
      <span aria-hidden="true"
            class="mx-auto mb-5 grid size-13.5 place-items-center rounded-2xl bg-brand text-22 text-white">!</span>
      <h2 class="mb-2.5 text-22 leading-[1.3] font-bold tracking-[-0.02em]">
        <%= t("lesson.proctor.guard_title") %>
      </h2>
      <p class="mb-6.5 text-15 leading-[1.65] text-balance text-ink-4">
        <%= t("lesson.proctor.guard_body") %>
      </p>
      <button type="button" data-action="proctor#resume"
              class="rounded-xl bg-brand px-7 py-3.25 text-15 font-semibold text-white
                     transition-colors hover:bg-brand-deep">
        <%= t("lesson.proctor.guard_btn") %>
      </button>
    </div>
  </div>
<% end %>
