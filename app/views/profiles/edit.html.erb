<% content_for :title, "#{t("profile.title")} — UTCC AI Academy" %>

<main id="main" class="mx-auto max-w-page px-4 pt-10 pb-20 sm:px-8">
  <div class="mx-auto max-w-[620px]">
    <h1 class="mb-2 text-28 leading-[1.15] font-bold tracking-[-0.03em] sm:text-34">
      <%= t("profile.title") %>
    </h1>
    <p class="mb-7 text-15 leading-[1.6] text-balance text-muted"><%= t("profile.subtitle") %></p>

    <section class="rounded-panel border border-hairline bg-surface px-6 py-7 sm:px-8.5">
      <%= form_with model: @user, url: profile_path, method: :patch do |form| %>
        <%# Two forms, one record: the summary belongs to whichever one was
            posted, or a rejected password would report itself above the name. %>
        <%= render "shared/form_errors", record: @user if @errors_on == :profile %>

        <%# Not a field. The student ID is issued by the university, is what
            sign-in authenticates on, and is absent from profile_params — so it
            is shown as the account's identity rather than offered for editing. %>
        <div class="mb-5.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-1
                    rounded-field bg-surface-2 px-4 py-3.25">
          <div>
            <div class="text-12-5 text-muted-2"><%= t("auth.fields.student_id") %></div>
            <div class="text-15 font-medium text-ink tabular-nums"><%= @user.student_id %></div>
          </div>
          <span class="text-12-5 text-muted-2"><%= t("profile.student_id_locked") %></span>
        </div>

        <div class="mb-6 flex flex-col gap-4">
          <%# The labels are auth.fields.* rather than a second copy under
              profile.*: the same field asked for on the same terms. %>
          <label class="flex flex-col gap-1.75">
            <span class="text-13-5 font-medium text-ink-4"><%= t("auth.fields.name") %></span>
            <%= form.text_field :name, size: nil, required: true, autocomplete: "name", maxlength: 60,
                  placeholder: t("auth.fields.name_placeholder"),
                  "aria-invalid": @user.errors[:name].any?.to_s,
                  class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3.75 py-3.25 text-15
                          text-ink transition-colors outline-none placeholder:text-muted-3 focus:border-brand-ink
                          aria-[invalid=true]:border-brand-alert" %>
          </label>

          <label class="flex flex-col gap-1.75">
            <span class="text-13-5 font-medium text-ink-4"><%= t("auth.fields.email") %></span>
            <%= form.email_field :email_address, autocomplete: "email",
                  placeholder: "you@utcc.ac.th",
                  "aria-invalid": @user.errors[:email_address].any?.to_s,
                  class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3.75 py-3.25 text-15
                          text-ink transition-colors outline-none placeholder:text-muted-3 focus:border-brand-ink
                          aria-[invalid=true]:border-brand-alert" %>
            <%# Optional, and the hint says what it is for: without an address
                /forgot-password has nothing to send a link to. %>
            <span class="text-12-5 leading-[1.55] text-muted-2"><%= t("profile.email_hint") %></span>
          </label>

          <label class="flex flex-col gap-1.75">
            <span class="text-13-5 font-medium text-ink-4"><%= t("profile.fields.faculty") %></span>
            <%= form.text_field :faculty, autocomplete: "organization",
                  placeholder: t("profile.fields.faculty_placeholder"),
                  class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3.75 py-3.25 text-15
                          text-ink transition-colors outline-none placeholder:text-muted-3 focus:border-brand-ink" %>
          </label>

          <label class="flex flex-col gap-1.75">
            <span class="text-13-5 font-medium text-ink-4"><%= t("profile.fields.study_year") %></span>
            <%# 1..8 matches the model's inclusion; blank clears the column. %>
            <%= form.select :study_year, 1..8,
                  { include_blank: t("profile.fields.study_year_blank") },
                  "aria-invalid": @user.errors[:study_year].any?.to_s,
                  class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3.75 py-3.25 text-15
                          text-ink transition-colors outline-none focus:border-brand-ink
                          aria-[invalid=true]:border-brand-alert" %>
          </label>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <%= form.submit t("profile.submit"),
                class: "cursor-pointer rounded-[12px] bg-brand px-6 py-3.25 text-15-5 font-semibold text-white
                        transition-colors hover:bg-brand-deep" %>
          <%= link_to t("profile.cancel"), my_learning_path,
                class: "px-2 text-14-5 font-medium text-muted hover:text-ink" %>
        </div>
      <% end %>
    </section>

    <section class="mt-6 rounded-panel border border-hairline bg-surface px-6 py-7 sm:px-8.5">
      <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="mb-1.5 text-19 font-bold tracking-[-0.02em]"><%= t("profile.sessions.title") %></h2>
          <p class="text-14 leading-[1.6] text-balance text-muted"><%= t("profile.sessions.subtitle") %></p>
        </div>
        <% if @sessions.size > 1 %>
          <%= button_to t("profile.sessions.revoke_other"), revoke_other_sessions_path, method: :delete,
                class: "rounded-field border-[1.5px] border-hairline-2 px-4 py-2.75 text-13-5 font-semibold text-ink-4
                        transition-colors hover:border-muted-3" %>
        <% end %>
      </div>

      <div class="flex flex-col divide-y divide-surface-3">
        <% @sessions.each do |session| %>
          <% current = session.id == Current.session.id %>
          <div class="flex flex-wrap items-center justify-between gap-4 py-4 first:pt-0 last:pb-0">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2 text-14-5 font-semibold text-ink">
                <span><%= t("profile.sessions.devices.#{session.device_family}") %></span>
                <% if current %>
                  <span class="rounded-full bg-brand-tint px-2.25 py-0.75 text-11-5 font-semibold text-brand-ink-deep">
                    <%= t("profile.sessions.current") %>
                  </span>
                <% end %>
              </div>
              <div class="mt-1 text-12-5 text-muted-2">
                <%= t("profile.sessions.started", time: l(session.created_at, format: :short)) %>
              </div>
            </div>

            <% unless current %>
              <%= button_to t("profile.sessions.revoke"), revoke_profile_session_path(session.revoke_token),
                    method: :delete,
                    class: "session-revoke rounded-field border-[1.5px] border-hairline-2 px-4 py-2.5 text-13-5 font-semibold text-ink-4
                            transition-colors hover:border-muted-3" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <%# The password is its own form and its own action — see ProfilesController.
        It sits below rather than beside: it is the thing a student came here to
        do second, and mixing it into the fields above would make one Save button
        mean two different commitments. %>
    <section class="mt-6 rounded-panel border border-hairline bg-surface px-6 py-7 sm:px-8.5">
      <h2 class="mb-1.5 text-19 font-bold tracking-[-0.02em]"><%= t("profile.password.title") %></h2>
      <p class="mb-6 text-14 leading-[1.6] text-balance text-muted"><%= t("profile.password.subtitle") %></p>

      <%= form_with url: profile_password_path, method: :patch do |form| %>
        <%# scope: nil — this form is not model-bound, so its fields render as
            id="current_password" rather than id="user_current_password". %>
        <%= render "shared/form_errors", record: @user, scope: nil if @errors_on == :password %>

        <div class="mb-6 flex flex-col gap-4">
          <label class="flex flex-col gap-1.75">
            <span class="text-13-5 font-medium text-ink-4"><%= t("profile.password.current") %></span>
            <%# autocomplete tells a password manager which of the three this is,
                so it offers the stored one here and a generated one below. %>
            <%= form.password_field :current_password, required: true, maxlength: 72,
                  autocomplete: "current-password", placeholder: "••••••••",
                  "aria-invalid": @user.errors[:current_password].any?.to_s,
                  class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3.75 py-3.25 text-15
                          text-ink transition-colors outline-none placeholder:text-muted-3 focus:border-brand-ink
                          aria-[invalid=true]:border-brand-alert" %>
          </label>

          <label class="flex flex-col gap-1.75">
            <span class="text-13-5 font-medium text-ink-4"><%= t("auth.fields.new_password") %></span>
            <%= form.password_field :password, required: true, minlength: 8, maxlength: 72,
                  autocomplete: "new-password", placeholder: "••••••••",
                  "aria-invalid": @user.errors[:password].any?.to_s,
                  class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3.75 py-3.25 text-15
                          text-ink transition-colors outline-none placeholder:text-muted-3 focus:border-brand-ink
                          aria-[invalid=true]:border-brand-alert" %>
            <span class="text-12-5 text-muted-2"><%= t("auth.fields.password_hint") %></span>
          </label>

          <label class="flex flex-col gap-1.75">
            <span class="text-13-5 font-medium text-ink-4"><%= t("auth.fields.new_password_confirmation") %></span>
            <%= form.password_field :password_confirmation, required: true, minlength: 8, maxlength: 72,
                  autocomplete: "new-password", placeholder: "••••••••",
                  "aria-invalid": @user.errors[:password_confirmation].any?.to_s,
                  class: "rounded-field border-[1.5px] border-hairline-2 bg-surface px-3.75 py-3.25 text-15
                          text-ink transition-colors outline-none placeholder:text-muted-3 focus:border-brand-ink
                          aria-[invalid=true]:border-brand-alert" %>
          </label>
        </div>

        <%= form.submit t("profile.password.submit"),
              class: "cursor-pointer rounded-[12px] bg-brand px-6 py-3.25 text-15-5 font-semibold text-white
                      transition-colors hover:bg-brand-deep" %>
      <% end %>

      <%# Saying so before the click, not after: the surprise is finding yourself
          signed out of the library computer you forgot about. %>
      <p class="mt-4 text-13-5 leading-[1.6] text-balance text-muted-2"><%= t("profile.password.note") %></p>
    </section>

    <%# The reset flow is still there for the other case — locked out, not signed
        in — and it is the one that needs the address above. %>
    <p class="mt-5 text-13-5 leading-[1.6] text-balance text-muted-2"><%= t("profile.password_note") %></p>
  </div>
</main>
