<%# The signed-in chrome: brand, primary nav, gamification counters,
    notifications and the account menu, over the gamification strip. Language
    and theme live inside that account menu rather than spending rail width. %>
<header class="sticky top-0 z-40 bg-chrome">
  <div class="mx-auto flex h-header max-w-page items-center gap-4 px-4 sm:px-8 xl:gap-6">
    <%# The shield is the accessible name for the link; the two-line lockup
        beside it repeats it visually, so it is decorative and drops out below
        `sm` where the nav needs the room. The footer and the auth hero carry
        the taller three-line version — this rail only has 64px to work in. %>
    <%= link_to root_path, class: "flex flex-none items-center gap-3 pr-1", title: "UTCC" do %>
      <%= image_tag "utcc-eng-shield.svg", alt: "UTCC",
                    width: 34, height: 34, class: "block h-[34px] w-auto", loading: "eager" %>
      <span aria-hidden="true"
            class="hidden flex-col gap-[3px] border-l border-chrome-line pl-3 leading-none whitespace-nowrap sm:flex">
        <span class="text-10-5 font-bold tracking-[0.11em] text-on-chrome uppercase">
          <%= t("chrome.brand_line") %>
        </span>
        <span class="text-9-5 font-medium tracking-[0.06em] text-on-chrome-dim">
          <%= t("chrome.brand_sub") %>
        </span>
      </span>
    <% end %>

    <%# Straight after the brand: the mark and the way into the app read as one
        gesture at the left edge, and the rail on the right stays what it is —
        notifications and the account. %>
    <%= render "shared/app_nav_menu" %>

    <%# `ml-auto` keeps the rail against the right edge; the menubar beside it
        takes only the width its categories need and scrolls if it cannot. %>
    <div class="ml-auto flex flex-none items-center gap-2" data-rail="session-actions">
      <%# Subscribed here rather than inside the bell, so a replacement cannot
          tear down the subscription that delivered it. The channel name still
          lives in exactly one place — the bell names it. %>
      <%= turbo_stream_from notification_bell.stream %>
      <%= render "shared/app_notifications", bell: notification_bell %>
      <%= render "shared/app_account_menu" %>
    </div>
  </div>

  <%# The gamification strip: hearts remaining, refill timer, and which
      semester the counters belong to.

      Hearts are a learner mechanic, so everyone else gets the strip for its
      semester context alone — a life counter reads as noise on /instructor,
      where the lives it counts are nobody's. Same line the proctor takes. With
      the counters gone the semester is the only thing left, so it stops hiding
      itself on narrow screens.

      Keyed on the workspace rather than on `student?`, because a company member
      holds the student role — ask the role and a recruiter is handed a heart
      counter for coursework they are not doing. See User#workspace.

      The strip is academy context — a term and a section — so a company member
      gets none of it rather than an empty bar announcing somebody else's
      semester. Their workspace has no academic calendar in it at all. %>
  <% unless current_workspace == :company %>
    <div data-strip="academy" class="border-t border-chrome-line-2 bg-chrome-deep">
      <div class="mx-auto flex max-w-page items-center gap-4 px-4 py-[9px] sm:px-8">
        <% if current_workspace == :student %>
          <span class="text-12-5 font-medium text-on-chrome">
            <%= t("chrome.hearts_left", count: progress.hearts, max: progress.hearts_max) %>
          </span>
          <div class="flex gap-1" aria-hidden="true">
            <% progress.hearts_max.times do |index| %>
              <span class="text-12 <%= index < progress.hearts ? "text-brand-ink" : "text-chrome-edge-2" %>">♥</span>
            <% end %>
          </div>
          <%# Derived, and only when a heart is actually missing — the old copy
              showed a hardcoded timer forever. %>
          <% if (refill_at = progress.heart_refill_at) %>
            <% minutes = ((refill_at - Time.current) / 60).ceil.clamp(0..) %>
            <span class="hidden text-12-5 text-on-chrome-dim sm:inline">
              <%= t("chrome.refill", hours: minutes / 60, minutes: minutes % 60) %>
            </span>
          <% end %>
        <% end %>
        <span class="<%= class_names(
                           "ml-auto text-12-5 text-on-chrome-dim",
                           "hidden lg:inline" => current_workspace == :student
                         ) %>">
          <%= t("chrome.semester") %>
        </span>
      </div>
    </div>
  <% end %>
</header>
