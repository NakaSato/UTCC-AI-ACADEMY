<%# The bell. Real rows since notifications landed — each is a kind plus
    interpolations, rendered in the reader's language at read time. The dot on
    the bell is the unread count's existence, and "mark all read" is the one
    write this menu has.

    Takes a `bell:` and reaches for nothing else. It used to query
    `Current.user` twice from inside the template, which was a view reaching past
    what it was handed; NotificationBell answers both questions now.

    A frame rather than a plain div, and deliberately one with no `src`: this is
    what a request renders, content and all. The version that names a src is
    `_app_notifications_refetch`, which is what a broadcast pushes — the frame is
    the seam between the two, and `NotificationsController#show` is what the
    second one comes back to. %>
<% notifications = bell.recent %>
<% unread = bell.unread? %>

<%= turbo_frame_tag bell.id, class: "relative block flex-none" do %>
<div data-controller="dropdown"
     data-action="click@window->dropdown#closeOnOutsideClick keydown@window->dropdown#closeOnEscape">
  <button type="button"
          aria-haspopup="true" aria-expanded="false" aria-label="<%= t("chrome.notif_toggle") %>"
          data-dropdown-target="button" data-action="dropdown#toggle"
          class="relative grid size-[38px] place-items-center rounded-[10px] border border-chrome-line bg-chrome-2
                 text-14 text-on-chrome hover:border-chrome-edge hover:text-white">
    <span aria-hidden="true">◔</span>
    <% if unread %>
      <span aria-hidden="true"
            class="absolute top-2 right-2 size-[7px] rounded-full border-[1.5px] border-chrome bg-brand"></span>
    <% end %>
  </button>

  <div class="absolute top-[46px] right-0 z-50 hidden w-[320px] overflow-hidden rounded-[14px] border border-hairline bg-surface shadow-menu"
       data-dropdown-target="panel">
    <div class="flex items-center justify-between border-b border-surface-3 px-4 py-3.5">
      <span class="text-14 font-bold text-ink"><%= t("chrome.notif_title") %></span>
      <% if unread %>
        <%= button_to t("chrome.notif_read_all"), read_notifications_path,
              class: "cursor-pointer text-12-5 text-brand hover:text-brand-deep" %>
      <% end %>
    </div>

    <% if notifications.empty? %>
      <p class="px-4 py-6 text-13 text-balance text-muted-2"><%= t("chrome.notif_empty") %></p>
    <% end %>

    <% notifications.each do |notification| %>
      <div class="flex gap-3 border-b border-surface-5 px-4 py-3.5 <%= "bg-brand-tint" if notification.unread? %>">
        <span aria-hidden="true"
              class="mt-1.5 size-[7px] flex-none rounded-full <%= notification.unread? ? "bg-brand" : "bg-transparent" %>"></span>
        <div>
          <div class="text-13-5 leading-[1.45] text-ink"><%= notification.text %></div>
          <% if notification.action_path %>
            <%# Out of the bell's frame: the destination is a whole screen, and a
                frame-scoped visit would look like a link that does nothing. %>
            <%= link_to notification.action_label, notification.action_path,
                  data: { turbo_frame: "_top" },
                  class: "mt-1 inline-block text-12-5 font-semibold text-brand hover:text-brand-deep" %>
          <% end %>
          <div class="mt-0.5 font-mono text-11 text-muted-2">
            <%= notification.created_at.in_time_zone.strftime("%d/%m %H:%M") %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
<% end %>
