<% if record.errors.any? %>
  <div class="rounded-md border-l-4 border-brand-alert bg-brand-tint p-4 text-18 text-brand-accent" role="alert">
    <p class="mb-1 font-bold">
      กรุณาตรวจสอบข้อมูลอีกครั้ง (<%= record.errors.count %> รายการ)
    </p>
    <ul class="list-disc pl-5">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
