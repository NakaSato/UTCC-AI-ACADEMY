<% if record.errors.any? %>
  <div role="alert"
       class="mb-4 rounded-field border border-danger-line bg-danger-tint px-4 py-3.25 text-14 text-brand-accent">
    <p class="mb-1 font-bold"><%= t("auth.errors_title", count: record.errors.count) %></p>
    <ul class="list-disc pl-5">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
