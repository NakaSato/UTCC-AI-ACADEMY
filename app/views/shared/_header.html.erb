<header class="relative z-20 w-full bg-brand pb-2 shadow-md"
        data-controller="header"
        data-header-pinned-class="fixed top-0 right-0 left-0"
        data-action="keydown@window->header#closeOnEscape">
  <nav class="mx-auto flex min-h-header w-full max-w-page items-center gap-4 px-4 xl:px-8" aria-label="หลัก">
    <div class="flex-none">
      <%= link_to root_path, class: "flex items-center gap-2 text-24 font-bold tracking-[0.01em] text-surface" do %>
        UTCC
        <small class="block text-18 font-light opacity-80">AI Fundamental</small>
      <% end %>
    </div>

    <div class="hidden flex-1 justify-center lg:flex">
      <div>
        <%# Animated underline: grows from the left on hover, retracts to the right.
            The left/right swap is what makes enter and exit animate oppositely. %>
        <% nav_links.each do |label, href| %>
          <a href="<%= href %>"
             class="relative mx-2 inline-block py-1 text-18 text-on-brand transition-colors duration-300 hover:text-surface
                    after:absolute after:right-0 after:bottom-0 after:left-auto after:block after:h-0.5 after:w-0
                    after:bg-on-brand after:transition-[width] after:duration-300 after:content-['']
                    hover:after:right-auto hover:after:left-0 hover:after:w-full"><%= label %></a>
        <% end %>
      </div>
    </div>

    <div class="ml-auto flex flex-none items-center gap-2">
      <%# Mobile-first: the account block only appears from lg up, where the burger hides. %>
      <% if authenticated? %>
        <div class="hidden items-center gap-2 lg:flex">
          <span class="grid size-9 flex-none place-items-center rounded-full bg-surface text-18 font-bold text-brand-deep"
                aria-hidden="true"><%= Current.user.initials %></span>
          <span class="text-18 text-surface"><%= Current.user.name %></span>
          <%= button_to "ออกจากระบบ", session_path, method: :delete,
                class: "text-18 text-on-brand transition-colors duration-300 hover:text-surface hover:underline",
                form: { class: "inline" } %>
        </div>
      <% else %>
        <div class="hidden items-center gap-2 lg:flex">
          <%= link_to "เข้าสู่ระบบ", new_session_path,
                class: "relative mx-2 inline-block py-1 text-18 text-on-brand transition-colors duration-300 hover:text-surface
                        after:absolute after:right-0 after:bottom-0 after:left-auto after:block after:h-0.5 after:w-0
                        after:bg-on-brand after:transition-[width] after:duration-300 after:content-['']
                        hover:after:right-auto hover:after:left-0 hover:after:w-full" %>
          <%# Cream pill with a deep-maroon label — the only button that reads correctly on the maroon bar. %>
          <%= link_to "สมัครสมาชิก", new_registration_path,
                class: "inline-flex items-center gap-2 rounded-full bg-surface px-6 py-2.5 text-18 leading-tight
                        font-normal whitespace-nowrap uppercase text-brand-deep shadow-md transition duration-300
                        hover:bg-brand-tint hover:shadow-lg active:scale-97" %>
        </div>
      <% end %>

      <button type="button"
              class="inline-flex rounded-full p-2 text-surface transition duration-300 hover:bg-surface/12 lg:hidden"
              data-action="header#toggle" aria-label="เปิดเมนู">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </nav>

  <div class="group invisible fixed inset-0 z-40 data-[open=true]:visible"
       data-header-target="drawer" data-open="false">
    <div class="absolute inset-0 bg-ink/70 opacity-0 transition-opacity duration-300 group-data-[open=true]:opacity-100"
         data-action="click->header#close"></div>

    <div class="absolute top-0 right-0 h-full w-[min(20rem,85vw)] translate-x-full overflow-y-auto bg-brand p-4
                shadow-2xl transition-transform duration-300 group-data-[open=true]:translate-x-0"
         role="dialog" aria-modal="true" aria-label="เมนู">
      <div class="mb-4 flex items-center justify-between text-surface">
        <span>เมนู</span>
        <button type="button" class="inline-flex rounded-full p-2 transition duration-300 hover:bg-surface/12"
                data-action="header#close" aria-label="ปิดเมนู">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <div class="flex flex-col gap-2">
        <% nav_links.each do |label, href| %>
          <a href="<%= href %>"
             class="border-b border-surface/20 py-2 text-on-brand transition-colors duration-300 hover:text-surface"
             data-action="header#close"><%= label %></a>
        <% end %>
      </div>

      <div class="mt-4 flex flex-col gap-2 text-surface">
        <% if authenticated? %>
          <p><%= Current.user.name %></p>
          <%= button_to "ออกจากระบบ", session_path, method: :delete,
                class: "inline-flex w-full items-center justify-center gap-2 rounded-full bg-surface px-6 py-2.5
                        text-18 leading-tight font-normal whitespace-nowrap uppercase text-brand-deep shadow-md
                        transition duration-300 hover:bg-brand-tint hover:shadow-lg active:scale-97" %>
        <% else %>
          <%# The drawer sits on the maroon field, so the default maroon-on-maroon
              outline button would be invisible here — it takes the light-on-dark variant. %>
          <%= link_to "เข้าสู่ระบบ", new_session_path,
                class: "inline-flex w-full items-center justify-center gap-2 rounded-full border border-surface
                        px-6 py-2.5 text-18 leading-tight font-normal whitespace-nowrap uppercase text-surface
                        transition duration-300 hover:bg-surface hover:text-brand-deep active:scale-97" %>
          <%= link_to "สมัครสมาชิก", new_registration_path,
                class: "inline-flex w-full items-center justify-center gap-2 rounded-full bg-surface px-6 py-2.5
                        text-18 leading-tight font-normal whitespace-nowrap uppercase text-brand-deep shadow-md
                        transition duration-300 hover:bg-brand-tint hover:shadow-lg active:scale-97" %>
        <% end %>
      </div>
    </div>
  </div>
</header>
