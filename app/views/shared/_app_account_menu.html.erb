<div class="relative flex-none"
     data-controller="dropdown"
     data-action="click@window->dropdown#closeOnOutsideClick keydown@window->dropdown#closeOnEscape">
  <button type="button"
          aria-haspopup="true" aria-expanded="false" aria-label="<%= t("chrome.user_toggle") %>"
          data-dropdown-target="button" data-action="dropdown#toggle"
          class="flex h-[38px] items-center gap-2 rounded-[10px] border border-chrome-line bg-chrome-2 pr-2.5 pl-[5px]
                 hover:border-chrome-edge">
    <span class="grid size-7 place-items-center rounded-lg bg-brand text-11 font-semibold text-white">
      <%= user_initials(Current.user) %>
    </span>
    <%# The student ID, not the name: it is fixed-width, so the rail keeps the
        same shape whoever is signed in. The name is one line down, in the panel. %>
    <span class="hidden text-12 text-on-chrome-2 tabular-nums 2xl:block"><%= Current.user.identifier %></span>
    <span aria-hidden="true" data-dropdown-target="indicator" class="text-9 text-on-chrome-dim">▾</span>
  </button>

  <div hidden data-state="closed"
       class="absolute top-[46px] right-0 z-50 w-[280px] rounded-[14px] border border-hairline bg-surface shadow-menu"
       data-menu="account" data-dropdown-target="panel">
    <div class="border-b border-surface-3 p-4">
      <div class="truncate text-14-5 font-semibold text-ink"><%= Current.user.name %></div>
      <%# The student ID, not the email — sign-up no longer collects one, so for
          most accounts email_address is blank. %>
      <div class="mt-0.5 truncate text-12 text-muted-2"><%= Current.user.identifier %></div>
    </div>

    <div class="p-1.5">
      <% app_user_menu.each do |label, path| %>
        <%= link_to label, path,
              class: "block rounded-[9px] px-3 py-2.5 text-13-5 text-ink-2 hover:bg-canvas" %>
      <% end %>
    </div>

    <%# Session-backed presentation preferences belong to the signed-in user,
        so they sit in the profile menu rather than occupying the header rail.
        Their embedded dropdowns expand in this panel and keep the same POST
        behavior as the public-navbar controls. %>
    <div class="flex flex-col gap-1 border-t border-surface-3 p-1.5">
      <%= render "shared/language_toggle", dark: false, embedded: true %>
      <%= render "shared/theme_toggle", dark: false, embedded: true %>
    </div>

    <div class="border-t border-surface-3 p-1.5">
      <%= button_to t("chrome.menu.logout"), logout_path, method: :delete,
            form_class: "block",
            class: "w-full rounded-[9px] px-3 py-2.5 text-left text-13-5 font-medium text-brand-ink hover:bg-brand-tint" %>
    </div>
  </div>
</div>
