<%# SEO / social metadata, ported from eng.utcc.ac.th — see docs/design-system.md.
    Pages override per-page values with content_for :title / :description / :meta_image. %>
<%# The defaults follow the locale: an English visitor who shares the link should
    not get a Thai preview card. %>
<% page_title       = content_for(:title).presence || t("meta.title") %>
<% page_description = content_for(:description).presence || t("meta.description") %>
<% page_image       = content_for(:meta_image).presence || "#{request.base_url}/icon.png" %>
<%# The canonical is the URL of *this* translation, not of the path — the whole
    point of ?lang= is that the English page is a page rather than a rendering
    of the Thai one. Query strings other than the language are screen state and
    are deliberately dropped: /leaderboard?tab=week is one page, not three. %>
<% canonical_url    = locale_url(I18n.locale) %>

<title><%= page_title %></title>
<meta name="title" content="<%= page_title %>">
<meta name="description" content="<%= page_description %>">
<meta name="keywords" content="<%= t("meta.keywords") %>">
<meta name="author" content="University of the Thai Chamber of Commerce">

<link rel="canonical" href="<%= canonical_url %>">

<%# Every translation, this one included — an hreflang set that does not name
    itself is discarded whole. x-default points at Thai: it is what a visitor
    with no matching language gets, which is the same rule switch_locale uses. %>
<% locale_urls.each do |locale, url| %>
<link rel="alternate" hreflang="<%= locale %>" href="<%= url %>">
<% end %>
<link rel="alternate" hreflang="x-default" href="<%= locale_url(I18n.default_locale) %>">

<%# Open Graph / Facebook %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="UTCC AI Academy">
<meta property="og:locale" content="<%= t("meta.og_locale") %>">
<% (I18n.available_locales - [ I18n.locale ]).each do |locale| %>
<meta property="og:locale:alternate" content="<%= t("meta.og_locale", locale: locale) %>">
<% end %>
<meta property="og:url" content="<%= canonical_url %>">
<meta property="og:title" content="<%= page_title %>">
<meta property="og:description" content="<%= page_description %>">
<meta property="og:image" content="<%= page_image %>">

<%# Twitter %>
<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content="<%= canonical_url %>">
<meta property="twitter:title" content="<%= page_title %>">
<meta property="twitter:description" content="<%= page_description %>">
<meta property="twitter:image" content="<%= page_image %>">

<%# The school itself, on every page. It carries an @id so a page's own documents
    — the landing page's course list, below — can name the provider by reference
    instead of repeating the address on each of them. %>
<%= json_ld({
        "@context" => "https://schema.org",
        "@type" => "EducationalOrganization",
        "@id" => organization_id,
        "name" => t("meta.org_name"),
        "alternateName" => t("meta.org_alt_name"),
        "url" => request.base_url,
        "sameAs" => [ "https://eng.utcc.ac.th/", "https://www.facebook.com/eng.utcc/" ],
        "address" => {
          "@type" => "PostalAddress",
          "streetAddress" => "อาคาร 19 ชั้น 3, 126/1 ซอยวิภาวดีรังสิต 2 แขวงรัชดาภิเษก เขตดินแดง",
          "addressLocality" => "กรุงเทพมหานคร",
          "postalCode" => "10400",
          "addressCountry" => "TH"
        },
        "contactPoint" => {
          "@type" => "ContactPoint",
          "telephone" => "+66-2-697-6705",
          "contactType" => "Customer Service"
        },
        "description" => page_description
      }) %>

<%# Whatever else this page has to declare — see SchemaHelper. Templates render
    before their layout, so a content_for in the body still lands in <head>. %>
<%= yield :schema %>
