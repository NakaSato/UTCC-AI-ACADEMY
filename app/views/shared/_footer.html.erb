<%# Shared chrome: every screen ends on this footer, signed in or out, as the
    design does — it sits on the same ink field as the header so the page
    closes on the chrome it opened with. Only the link columns differ by
    session; see ApplicationHelper#footer_columns.

    Four columns on desktop: a wide brand block plus the three link columns
    from `footer_columns`. Below lg the grid drops to two and the brand block
    spans both, which keeps the link columns paired rather than stacked into a
    long ribbon. %>
<footer class="mt-10 bg-chrome">
  <div class="mx-auto grid w-full max-w-page grid-cols-2 gap-x-7 gap-y-[34px] px-4 pt-10
              lg:grid-cols-[minmax(0,1.3fr)_repeat(3,minmax(0,1fr))] lg:gap-10 lg:pt-[54px] xl:px-8">
    <div class="col-span-2 lg:col-span-1">
      <%# Same lockup as the header, one step smaller: the shield carries the
          brand and the wordmark beside it is the accessible name, so the image
          is decorative. %>
      <div class="mb-[18px] flex items-center gap-3.5">
        <%= image_tag "utcc-eng-shield.svg", alt: "", aria: { hidden: true },
                      width: 40, height: 40, loading: "lazy",
                      class: "block h-10 w-auto" %>
        <span class="flex flex-col justify-center border-l border-chrome-line pl-3.5 leading-[1.15]">
          <span class="text-15 font-semibold tracking-[-0.01em] text-white">UTCC</span>
          <span class="text-10 font-medium tracking-[0.11em] text-on-chrome-muted uppercase">
            <%= t("chrome.brand_line") %>
          </span>
          <span class="mt-[3px] text-9-5 font-medium tracking-[0.06em] text-on-chrome-dim">
            <%= t("chrome.brand_sub") %>
          </span>
        </span>
      </div>

      <p class="mb-4 max-w-[40ch] text-13-5 leading-[1.7] text-pretty text-on-chrome-muted">
        <%= t("chrome.footer.tagline") %>
      </p>
      <%# The disclaimer is the one place the crimson shows on this field — a
          rule rather than a fill, so it reads as an aside and not an action. %>
      <p class="max-w-[42ch] border-l-2 border-brand-ink pl-3 text-12-5 leading-[1.65] text-pretty text-on-chrome-dim">
        <%= t("chrome.footer.by") %>
      </p>
    </div>

    <% footer_columns.each do |column, links| %>
      <div>
        <div class="mb-4 text-11 font-semibold tracking-[0.11em] text-on-chrome-dim uppercase">
          <%= t("chrome.footer.columns.#{column}.title") %>
        </div>
        <div class="flex flex-col items-start gap-[11px]">
          <% links.each do |link, href| %>
            <a href="<%= href %>"
               class="text-left text-13-5 leading-[1.5] text-on-chrome transition-colors duration-150 hover:text-white">
              <%= t("chrome.footer.columns.#{column}.links.#{link}") %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mx-auto mt-8 flex w-full max-w-page flex-col items-start gap-3.5 border-t border-chrome-line-2
              px-4 pt-[22px] pb-[30px] sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-6
              lg:mt-11 xl:px-8">
    <span class="text-12-5 text-on-chrome-dim"><%= t("chrome.footer.rights") %></span>
    <div class="flex flex-wrap items-center gap-[22px]">
      <%= link_to t("chrome.footer.pdpa"), privacy_path,
            class: "text-12-5 text-on-chrome-muted transition-colors duration-150 hover:text-white" %>
      <%= link_to t("chrome.footer.terms"), terms_path,
            class: "text-12-5 text-on-chrome-muted transition-colors duration-150 hover:text-white" %>
    </div>
  </div>
</footer>

<button type="button"
        class="invisible fixed right-4 bottom-4 z-30 grid size-12 place-items-center rounded-full bg-brand
               text-white opacity-0 shadow-lg
               data-[visible=true]:visible data-[visible=true]:opacity-100"
        data-controller="to-top" data-action="to-top#scrollUp" data-visible="false"
        aria-label="<%= t("chrome.to_top") %>">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2" aria-hidden="true">
    <path d="M12 19V5M6 11l6-6 6 6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</button>
