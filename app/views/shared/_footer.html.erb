<footer class="text-center text-24 text-surface">
  <div class="bg-footer-top py-16">
    <div class="mx-auto w-full max-w-page px-4 xl:px-8">
      <%# Desktop: 4-column grid, links block spans 3 and splits into 3 columns.
          Mobile: single column, and the link columns collapse into accordions. %>
      <div class="grid grid-cols-1 gap-4 text-left lg:grid-cols-4">
        <div class="lg:col-span-3">
          <div class="hidden gap-4 lg:grid lg:grid-cols-3">
            <% footer_columns.each do |title, links| %>
              <div>
                <div class="pb-4 text-30 font-normal"><%= title %></div>
                <ul>
                  <% links.each do |label, href| %>
                    <li class="text-left text-20 font-light">
                      <a href="<%= href %>"
                         class="opacity-70 transition-opacity duration-300 hover:opacity-100"><%= label %></a>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>

          <div class="lg:hidden">
            <% footer_columns.each do |title, links| %>
              <details class="group mb-2 border-b border-surface">
                <summary class="marker-none flex cursor-pointer items-center justify-between gap-4 py-4 text-30
                                font-medium after:size-[0.6em] after:flex-none after:rotate-45 after:border-r-2
                                after:border-b-2 after:border-current after:transition-transform after:duration-300
                                after:content-[''] group-open:after:rotate-[-135deg]"><%= title %></summary>
                <div class="px-4 pb-4">
                  <ul>
                    <% links.each do |label, href| %>
                      <li class="text-left text-20 font-light">
                        <a href="<%= href %>"
                           class="opacity-70 transition-opacity duration-300 hover:opacity-100"><%= label %></a>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </details>
            <% end %>
          </div>
        </div>

        <div class="text-left text-20 font-light">
          <h3 class="mb-4 text-30 font-normal">ติดต่อเรา</h3>
          <p>คณะวิศวกรรมศาสตร์<br>มหาวิทยาลัยหอการค้าไทย</p>
          <p>126/1 ถนนวิภาวดีรังสิต<br>ดินแดง กรุงเทพฯ 10400</p>
          <div class="mt-4 flex gap-4">
            <a href="#" aria-label="Facebook"
               class="grid size-10 place-items-center rounded-full border border-surface/40 opacity-80 transition duration-300 hover:bg-surface/12 hover:opacity-100">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13 22v-9h3l1-4h-4V7c0-1.1.3-1.8 1.9-1.8H17V1.8C16.4 1.7 15.2 1.6 14 1.6c-2.7 0-4.5 1.6-4.5 4.6V9H6v4h3.5v9H13z"/>
              </svg>
            </a>
            <a href="#" aria-label="YouTube"
               class="grid size-10 place-items-center rounded-full border border-surface/40 opacity-80 transition duration-300 hover:bg-surface/12 hover:opacity-100">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23 12s0-3.6-.5-5.3a2.7 2.7 0 0 0-1.9-1.9C18.9 4.3 12 4.3 12 4.3s-6.9 0-8.6.5a2.7 2.7 0 0 0-1.9 1.9C1 8.4 1 12 1 12s0 3.6.5 5.3c.3 1 1 1.7 1.9 1.9 1.7.5 8.6.5 8.6.5s6.9 0 8.6-.5a2.7 2.7 0 0 0 1.9-1.9c.5-1.7.5-5.3.5-5.3zM9.8 15.3V8.7l5.7 3.3-5.7 3.3z"/>
              </svg>
            </a>
            <a href="#" aria-label="Line"
               class="grid size-10 place-items-center rounded-full border border-surface/40 opacity-80 transition duration-300 hover:bg-surface/12 hover:opacity-100">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.5 2 2 5.7 2 10.2c0 4 3.6 7.4 8.4 8 .3.1.8.2.9.5.1.3.1.7 0 1l-.2.9c0 .3-.2 1 .9.6 1.1-.5 6-3.5 8.2-6 1.5-1.6 2.2-3.3 2.2-5C22 5.7 17.5 2 12 2z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-footer-btm py-10 text-20">
    <div class="mx-auto w-full max-w-page px-4 xl:px-8">
      © <%= Time.current.year %> University of the Thai Chamber of Commerce
    </div>
  </div>
</footer>

<button type="button"
        class="invisible fixed right-4 bottom-4 z-30 grid size-12 place-items-center rounded-full bg-brand
               text-surface opacity-0 shadow-lg transition duration-300
               data-[visible=true]:visible data-[visible=true]:opacity-100"
        data-controller="to-top" data-action="to-top#scrollUp" aria-label="กลับขึ้นด้านบน">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2" aria-hidden="true">
    <path d="M12 19V5M6 11l6-6 6 6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</button>
