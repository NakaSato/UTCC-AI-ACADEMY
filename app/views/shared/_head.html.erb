<%# Shared by the application and auth layouts — the only difference between
    the two is the chrome around <body>, not what goes in <head>. %>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<%= render "shared/meta" %>

<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="UTCC AI Academy">
<meta name="mobile-web-app-capable" content="yes">
<%# The one hex outside the @theme block, because a meta tag cannot read a CSS
    variable — see docs/design-system.md. It mirrors --color-chrome, and chrome
    is the same value in both palettes, so one tag still answers for both. %>
<meta name="theme-color" content="#17120F">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= yield :head %>

<%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

<link rel="icon" href="/icon.png" type="image/png">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon.png">

<%= render "shared/fonts" %>

<%# The Tailwind build from app/assets/tailwind/application.css %>
<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "katex", "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
