<%# The palette chooser stays a set of POST forms — never links — because Turbo
    prefetches links on hover. The public header switches directly between light
    and dark; the signed-in account menu retains its full three-choice dropdown,
    including the system preference. %>
<% dark = local_assigns.fetch(:dark, true) %>
<% embedded = local_assigns.fetch(:embedded, false) %>
<% direct = local_assigns.fetch(:direct, false) %>
<% chosen = session[:theme].in?(%w[ light dark ]) ? session[:theme] : "system" %>
<% themes = { "light" => "☀", "dark" => "☾", "system" => "◐" } %>
<% switch_theme = chosen == "dark" ? "light" : "dark" if direct %>

<div class="relative <%= embedded ? "w-full" : "flex-none" %>" data-preference="theme"
     <% unless direct %>data-controller="dropdown"
       data-action="click@window->dropdown#closeOnOutsideClick keydown@window->dropdown#closeOnEscape"<% end %>>
  <% if direct %>
    <%= button_to theme_path(switch_theme),
          form: { data: { turbo: false } }, form_class: "block",
          class: "flex h-[38px] items-center gap-2 rounded-[10px] border px-2.5 text-12 font-semibold transition-colors #{dark ? "border-chrome-line bg-chrome-2 text-on-chrome hover:border-chrome-edge hover:text-white" : "border-hairline-2 bg-surface-2 text-ink hover:border-brand-ink"}",
          aria: { label: t("chrome.theme_switch", theme: t("chrome.theme.#{switch_theme}")) } do %>
      <span aria-hidden="true"><%= themes.fetch(switch_theme) %></span>
      <span><%= t("chrome.theme.#{switch_theme}") %></span>
    <% end %>
  <% else %>
  <button type="button" aria-haspopup="true" aria-expanded="false"
          aria-label="<%= t("chrome.theme_toggle", theme: t("chrome.theme.#{chosen}")) %>"
          data-dropdown-target="button" data-action="dropdown#toggle"
          class="flex h-[38px] items-center gap-2 rounded-[10px] border px-2.5 text-12 font-semibold transition-colors
                 <%= "w-full" if embedded %>
                 <%= dark ? "border-chrome-line bg-chrome-2 text-on-chrome hover:border-chrome-edge hover:text-white" :
                            "border-hairline-2 bg-surface-2 text-ink hover:border-brand-ink" %>">
    <span aria-hidden="true"><%= themes.fetch(chosen) %></span>
    <% if embedded %>
      <span><%= t("chrome.theme_label") %></span>
      <span class="ml-auto font-normal text-muted"><%= t("chrome.theme.#{chosen}") %></span>
    <% else %>
      <span><%= t("chrome.theme.#{chosen}") %></span>
    <% end %>
    <span aria-hidden="true" data-dropdown-target="indicator"
          class="text-9 <%= dark ? "text-on-chrome-dim" : "text-muted-2" %>">▾</span>
  </button>

  <div hidden data-state="closed"
       class="<%= embedded ? "static mt-1 w-full" : "absolute top-[46px] right-0 z-50 w-[170px]" %> overflow-hidden rounded-[14px]
              border border-hairline bg-surface p-1.5 shadow-menu"
       data-dropdown-target="panel" role="group" aria-label="<%= t("chrome.theme_label") %>">
    <% themes.each do |theme, glyph| %>
      <% current = chosen == theme %>
      <%# A real navigation, not a Turbo visit. Turbo copies `lang` and `dir`
          from <html>, but not its theme class, so this form still opts out. %>
      <%= button_to theme_path(theme),
            form: { data: { turbo: false } }, form_class: "block",
            "aria-current": ("true" if current),
            class: class_names(
              "flex w-full items-center gap-2.5 rounded-[9px] px-3 py-2.5 text-left text-13-5 transition-colors",
              "bg-brand-tint font-semibold text-brand-ink-deep" => current,
              "text-ink-2 hover:bg-canvas" => !current
            ) do %>
        <span aria-hidden="true" class="w-4 text-center"><%= glyph %></span>
        <span><%= t("chrome.theme.#{theme}") %></span>
        <% if current %><span aria-hidden="true" class="ml-auto">✓</span><% end %>
      <% end %>
    <% end %>
  </div>
  <% end %>
</div>
