<%# The palette toggle, built as the twin of shared/_language_toggle: same
    segmented shell, same POST-not-GET reasoning, same `dark:` local for the two
    fields it sits on. Three states rather than two, because "follow my system"
    is a real answer and not the absence of one — it is stored as no session
    value, which is what lets the media query answer instead.

    Icons rather than words: three labels would be wider than the header's
    utility rail affords, and the accessible name carries the meaning. %>
<% dark = local_assigns.fetch(:dark, true) %>
<% chosen = session[:theme].in?(%w[ light dark ]) ? session[:theme] : "system" %>

<div role="group" aria-label="<%= t("chrome.theme_label") %>"
     class="flex flex-none gap-0 rounded-[10px] border p-[3px]
            <%= dark ? "border-chrome-line bg-chrome-2" : "border-hairline-2 bg-surface-2" %>">
  <% { "light" => "☀", "system" => "◐", "dark" => "☾" }.each do |theme, glyph| %>
    <% current = chosen == theme %>
    <%# A real navigation, not a Turbo visit. Turbo replaces <body> and merges
        <head>, but never touches attributes on <html> — measured, not assumed:
        after a Turbo submit the class stayed empty and only appeared on a full
        reload, so the palette would not change until the visitor happened to
        reload. One full load on an action taken once in a while is the cheaper
        side of that trade. %>
    <%= button_to theme_path(theme),
          form: { data: { turbo: false } },
          form_class: "contents",
          "aria-current": ("true" if current),
          title: t("chrome.theme.#{theme}"),
          class: class_names(
            "rounded-[7px] px-2 py-[5px] text-12 leading-none transition-colors",
            "bg-brand text-white" => current,
            "text-on-chrome-muted hover:text-on-chrome-bright" => !current && dark,
            "text-muted hover:text-ink" => !current && !dark
          ) do %>
      <span aria-hidden="true"><%= glyph %></span>
      <span class="sr-only"><%= t("chrome.theme.#{theme}") %></span>
    <% end %>
  <% end %>
</div>
