{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "BUNDLE_GEMFILE=docs/Gemfile bundle install && npm ci",
  "buildCommand": "script/build-dashboard",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "0 1 * * *"
    }
  ]
}
