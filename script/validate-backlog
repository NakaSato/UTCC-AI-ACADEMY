#!/usr/bin/env ruby

require "json"
require "time"

# A link the dashboard can actually resolve: somewhere else entirely, an
# anchor on the page itself, or a file the site renders. Anything else — most
# often a bare repository path like `bin/verify` — is resolved against the
# rendered site, found missing, and aborts the deploy.
def renderable_link?(url)
  return true if url.match?(%r{\A[a-z][a-z0-9+.-]*:}i)
  return true if url.start_with?("#")

  url.split("#").first.to_s.end_with?(".html", ".json")
end

# A link with the right shape pointing at nothing is the failure this file could
# not see. `renderable_link?` stops at the shape, so an evidence link naming a
# document that does not exist passes. On 2026-08-12 the documentation site
# turned out to have been frozen since 2026-08-07, and every relative link in
# this file was resolving to nothing with no check noticing — the shape was
# right the whole time.
#
# Fetching them would tie the build to a deploy it does not control, which is
# the wrong trade. What is checkable offline is the half that is ours: the site
# is built from docs/, so `specs/spec-x.html` is a promise that `docs/spec-x.md`
# exists. validate-markdown-graph already holds every Markdown link to that
# rule. Backlog evidence was the one link surface without it.
def unresolved_source(url, root)
  return if url.match?(%r{\A[a-z][a-z0-9+.-]*:}i) || url.start_with?("#")

  target = url.split("#").first.to_s.split("?").first.to_s
  return if target.empty?

  source = File.join("docs", target.sub(/\.html\z/, ".md"))

  source unless File.file?(File.join(root, source)) ||
                File.file?(File.join(root, "docs", target))
end

path = ARGV.fetch(0, "docs/backlog.json")
root = File.dirname(File.dirname(path))
backlog = JSON.parse(File.read(path, encoding: Encoding::UTF_8))
errors = []

errors << "schema_version must equal 1" unless backlog["schema_version"] == 1
errors << "updated_at must be a string" unless backlog["updated_at"].is_a?(String)

allowed_statuses = backlog["allowed_statuses"]
items = backlog["items"]
updates = backlog["updates"]

errors << "allowed_statuses must be an array" unless allowed_statuses.is_a?(Array)
errors << "items must be an array" unless items.is_a?(Array)
errors << "updates must be an array" unless updates.is_a?(Array)

if allowed_statuses.is_a?(Array) && items.is_a?(Array)
  ids = items.map { |item| item["id"] }.compact
  errors << "item IDs must be unique" unless ids.uniq.length == ids.length

  items.each do |item|
    id = item["id"] || "(missing ID)"
    errors << "#{id}: invalid status" unless allowed_statuses.include?(item["status"])

    %w[owner priority updated_at].each do |field|
      errors << "#{id}: missing #{field}" unless item.key?(field)
    end

    if item["status"] == "blocked" && item["blocker"].nil?
      errors << "#{id}: blocked items require a blocker"
    end

    # Evidence is either a page of the rendered documentation site or a URL
    # somewhere else. A bare repository path is neither, and the failure is
    # remote and silent: the dashboard build resolves it against the rendered
    # site, finds nothing, and aborts — so the deployment stops updating while
    # the last good copy stays online looking current. That is exactly what
    # happened on 2026-08-09, and it went unnoticed for two days because the
    # only symptom was a status page quietly showing older news.
    (item["evidence"] || []).each do |evidence|
      url = evidence["url"].to_s
      next if renderable_link?(url)

      errors << "#{id}: evidence #{url.inspect} is neither an absolute URL nor a " \
                "rendered site file — a repository path must be a full github.com link"
    end

    (item["evidence"] || []).each do |evidence|
      missing = unresolved_source(evidence["url"].to_s, root)
      next if missing.nil?

      errors << "#{id}: evidence #{evidence['url'].inspect} names a page the site " \
                "does not build — no #{missing}"
    end
  end
end

# The roadmap's status columns and the backlog disagreed on 2026-08-12, in both
# directions at once. The UTCC summary table still called five finished
# milestones "Next" or "Later", and the consolidated table still described the
# Student Internship Request Platform as "Increments 1–3 implemented" after
# increment 4 had shipped. Nothing caught either one, because until now nothing
# read both files.
#
# The roadmap is what a person opens to decide what to build next, so a stale
# cell sends somebody to build what already exists, or to leave alone what
# nobody has started. Only the comparable part is compared: a milestone the
# backlog tracks is finished exactly when every one of its items is complete.
# Milestones with no backlog items — the M0 baseline, and proposals not yet
# accepted into delivery — have nothing to compare against and are left alone.
#
# One sharp edge to know about: a milestone whose only items are documentation
# would be read here as delivered. Discovery and gate documents are therefore
# filed under the current milestone, the way every DOCS item already is, and not
# under the milestone they describe. Filing them the other way would have this
# check demand the roadmap call an unstarted milestone Complete.
DONE = "Complete"

# The other sharp edge, found on 2026-08-12 when this check was pointed at the
# recruitment track: finishing every item a milestone tracks is not the same as
# delivering the milestone as the roadmap describes it. Six AI milestones had
# one complete item each, and each item shipped a first slice its own
# specification calls narrower than the milestone — an advisory panel rather
# than a recruiter agent, one report rather than analytics, a control contract
# rather than an integration. This check demanded the word "Complete" against
# every one of them, which is how the roadmap came to credit the platform with
# capabilities nobody built.
#
# So "delivered" is two labels, not one. Both assert that the tracked work is
# finished, which is the only thing the backlog can testify to; "First slice"
# adds that the milestone's own description is larger, which is a scope
# judgement no file can make. What is still caught in both directions is the
# drift that matters: a milestone with open items may claim neither label, and a
# milestone with none open must claim one of them.
DELIVERED = /\A(#{DONE}|First slice)\b/

# Track IDs are namespaced in the roadmap so `UTCC M10`, `AI M10`, and
# `Ecosystem M10` cannot be confused. The backlog names the same milestones
# differently, so the two vocabularies are mapped rather than matched.
#
# `Ecosystem M13` is the one the backlog files under a bare `M13`, because it
# was the only M13 in delivery when the item was written. It is mapped here
# rather than renamed so the check covers it; a UTCC M13 arriving later is the
# moment to rename both.
def backlog_milestone(track_id)
  case track_id
  when "Ecosystem M10" then "M10-CBP"
  when "Ecosystem M11" then "M11-SIR"
  when "Ecosystem M13" then "M13"
  when /\AUTCC (M\d+)\z/ then Regexp.last_match(1)
  when /\AAI (M\d+)\z/ then "AI-#{Regexp.last_match(1)}"
  end
end

def disagreement(milestone, label, items)
  owned = items.select { |item| item["milestone"] == milestone }
  return if owned.empty?

  open = owned.reject { |item| item["status"] == "complete" }

  if open.empty? && !label.match?(DELIVERED)
    "says #{label.inspect}, but all #{owned.length} of its backlog items are complete — " \
      "say #{DONE.inspect}, or #{'First slice'.inspect} if the milestone is larger than what shipped"
  elsif open.any? && label.match?(DELIVERED)
    "says #{label.inspect}, but #{open.length} backlog item(s) are open: " \
      "#{open.map { |item| "#{item['id']} (#{item['status']})" }.join(', ')}"
  end
end

# The two track tables name their milestones by a bare `M10`, and there are
# three different M10s in this file. What disambiguates them is the `##` section
# they sit under, so the section is tracked and the bare ID resolved through it.
#
# Without this the check read three tables out of five, which is how the AI
# track came to call all fifteen of its milestones Proposed while every one of
# them had a complete backlog item, for four days, under a gate built to catch
# exactly that.
TRACK_SECTIONS = {
  "AI Recruitment Platform Roadmap" => ->(id) { "AI-#{id}" },
  "Company Business Case Platform Roadmap" =>
    ->(id) { { "M10" => "M10-CBP", "M11" => "M11-SIR", "M13" => "M13" }[id] }
}.freeze

def roadmap_statuses(lines)
  found = []
  table = nil
  milestone = nil
  section = nil

  lines.each_with_index do |raw, index|
    line = raw.chomp
    location = "roadmap.md:#{index + 1}"

    section = Regexp.last_match(1) if line =~ /\A## (.+?)\s*\z/

    case line
    when /\A\|\s*Order\s*\|\s*Track ID\s*\|/ then table = :consolidated
    when /\A\|\s*Order\s*\|\s*Milestone\s*\|/ then table = :summary
    when /\A\|\s*ID\s*\|\s*Milestone\s*\|/ then table = :track
    when /\A\s*\z/ then table = nil
    end

    # The per-milestone heading and its own status line, which is a second
    # place the same fact is written down.
    milestone = "M#{Regexp.last_match(1)}" if line =~ /\A## Milestone (\d+) /
    if milestone && line =~ /\A\*\*Status: (.+)\*\*\s*\z/
      found << { milestone: milestone, label: Regexp.last_match(1), where: "#{location} (#{milestone} section)" }
      milestone = nil
    end

    next unless table && line.start_with?("|")

    cells = line.split("|").map(&:strip)

    id = case table
    in :track then cells[1]&.match?(/\AM\d+\z/) ? TRACK_SECTIONS[section]&.call(cells[1]) : nil
    in :consolidated then cells[1]&.match?(/\A\d+\z/) ? backlog_milestone(cells[2]) : nil
    in :summary then cells[1]&.match?(/\A\d+\z/) ? "M#{cells[1]}" : nil
    end
    next if id.nil?

    # Status is the last column in the two planning tables and the fourth in the
    # track tables, which end with the dependency. Reading the last cell in all
    # three reported every track row as saying "M6, M7".
    label = table == :track ? cells[4].to_s : cells.last

    found << { milestone: id, label: label, where: "#{location} (#{table} table, #{cells[2]})" }
  end

  found
end

roadmap_path = File.join(File.dirname(path), "roadmap.md")

if items.is_a?(Array) && File.exist?(roadmap_path)
  roadmap_statuses(File.readlines(roadmap_path, encoding: Encoding::UTF_8)).each do |row|
    problem = disagreement(row[:milestone], row[:label], items)
    errors << "#{row[:where]}: #{row[:milestone]} #{problem}" if problem
  end
end

# A timestamp in the future is how this file stops being a record and starts
# being a plan. It happened by hand on 2026-08-12: writing several entries in
# one sitting and spacing them half an hour apart to keep them ordered walked
# three of them past the clock, and nine older entries were already up to twenty
# hours ahead. Nothing noticed, because the field is only ever read by people.
#
# The ordering instinct is right and the method is wrong: `updates` is not sorted
# and does not need to be, so an entry never has to be dated later than the one
# above it. This warns rather than aborts — the existing entries are somebody
# else's to explain, and a wrong clock should not be able to block a build.
if items.is_a?(Array) && updates.is_a?(Array)
  now = Time.now
  ahead = []

  items.each do |item|
    stamp = item["updated_at"].to_s
    next if stamp.empty?

    parsed = begin
      Time.parse(stamp)
    rescue ArgumentError
      errors << "#{item['id']}: updated_at #{stamp.inspect} is not a timestamp"
      next
    end

    ahead << "#{item['id']} (item, #{stamp})" if parsed > now
  end

  updates.each_with_index do |update, index|
    stamp = update["at"].to_s
    next if stamp.empty?

    parsed = begin
      Time.parse(stamp)
    rescue ArgumentError
      errors << "update #{index} (#{update['item_id']}): at #{stamp.inspect} is not a timestamp"
      next
    end

    ahead << "#{update['item_id']} (update #{index}, #{stamp})" if parsed > now
  end

  unless ahead.empty?
    warn("warning: #{ahead.length} backlog timestamp(s) are in the future, so the " \
         "record describes work as done before it is:\n  #{ahead.sort.join("\n  ")}")
  end
end

if updates.is_a?(Array)
  updates.each_with_index do |update, index|
    %w[at item_id summary].each do |field|
      errors << "update #{index}: missing #{field}" unless update.key?(field)
    end

    url = update["evidence_url"].to_s
    next if url.empty?

    errors << "update #{index} (#{update['item_id']}): evidence_url #{url.inspect} " \
              "is neither an absolute URL nor a rendered site file" unless renderable_link?(url)

    missing = unresolved_source(url, root)
    errors << "update #{index} (#{update['item_id']}): evidence_url #{url.inspect} " \
              "names a page the site does not build — no #{missing}" if missing
  end
end

abort(errors.join("\n")) unless errors.empty?

puts "#{path} is valid."
