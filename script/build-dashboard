#!/usr/bin/env bash

set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_dir="$(mktemp -d "${TMPDIR:-/tmp}/utcc-dashboard.XXXXXX")"

cleanup() {
  rm -rf "${source_dir}"
}
trap cleanup EXIT

cd "${repository_root}"

bin/docs

mkdir -p "${source_dir}/_data"
cp -R docs/. "${source_dir}/"
cp docs/backlog.json "${source_dir}/_data/backlog.json"
ruby script/write-build-metadata "${source_dir}"
npx tailwindcss \
  -i docs/assets/css/tailwind.css \
  -o "${source_dir}/assets/css/style.css" \
  --minify

BUNDLE_GEMFILE=docs/Gemfile bundle exec jekyll build \
  --source "${source_dir}" \
  --destination "${repository_root}/_site"

ruby script/validate-rendered-doc-links "${repository_root}/_site"
